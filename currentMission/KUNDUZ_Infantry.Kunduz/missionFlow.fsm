        fsmName = "missionFlow";
        class States
        {
                /*%FSM<STATE "start">*/
                class start
                {
                        name = "start";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"_cars = [car_1, car_2, car_3];" \n
                         "_car_1_destroyed = false;" \n
                         "_car_2_destroyed = false;" \n
                         "_car_3_destroyed = false;" \n
                         "" \n
                         "// setup random positions for cars " \n
                         "// setup patrols" \n
                         "{" \n
                         "	_newPos = [carPositionArea] call BIS_fnc_randomPosTrigger;" \n
                         "	_groupPatrolPos = [_newPos, 20, 50] call BIS_fnc_findSafePos;" \n
                         "	_x setPosATL _newPos;" \n
                         "	" \n
                         "	_groupPatrol = [" \n
                         "		_groupPatrolPos, east," \n
                         "		[""UK3CB_TKA_O_GL"", ""UK3CB_TKA_O_RIF_1"", ""UK3CB_TKA_O_LAT""]" \n
                         "	] call BIS_fnc_spawnGroup;" \n
                         "    _groupPatrol deleteGroupWhenEmpty true;" \n
                         "	[_groupPatrol, _newPos, 100] call BIS_fnc_taskPatrol;" \n
                         "" \n
                         "    _driverPos = [_newPos, 10, 20] call BIS_fnc_findSafePos;" \n
                         "    _groupDriver = [" \n
                         "        _driverPos, east, [""UK3CB_TKA_O_RIF_1""]" \n
                         "    ] call BIS_fnc_spawnGroup;" \n
                         "    _groupDriver deleteGroupWhenEmpty true;" \n
                         "    _driver = (units _groupDriver) select 0;" \n
                         "    [_driver, _car] execFSM ""scripts\saveCar.fsm"";" \n
                         "} forEach _cars;" \n
                         "" \n
                         "[""taskMain""] call pf_tasks;" \n
                         "" \n
                         "_introDone = false;" \n
                         "" \n
                         "_missionStart = true;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
