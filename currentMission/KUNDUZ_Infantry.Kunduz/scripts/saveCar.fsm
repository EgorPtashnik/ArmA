                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "delete_wp">*/
                class delete_wp
                {
                        name = "delete_wp";
                        itemno = 10;
                        init = /*%FSM<STATEINIT""">*/"deleteWaypoint ((waypoints _group) select 0);" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "_">*/
                                class _
                                {
                                        itemno = 11;
                                        priority = 0.000000;
                                        to="_";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
