                /*%FSM</STATE>*/
                /*%FSM<STATE "set_timer">*/
                class set_timer
                {
                        name = "set_timer";
                        itemno = 5;
                        init = /*%FSM<STATEINIT""">*/"_t = time;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "___seconds">*/
                                class ___seconds
                                {
                                        itemno = 6;
                                        priority = 0.000000;
                                        to="wait_until_comba";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > _t + 5"/*%FSM</CONDITION""">*/;
