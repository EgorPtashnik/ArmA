                /*%FSM</STATE>*/
                /*%FSM<STATE "save_car_task">*/
                class save_car_task
                {
                        name = "save_car_task";
                        itemno = 13;
                        init = /*%FSM<STATEINIT""">*/"if (alive _car) then {" \n
                         "	_driver assignAsDriver _car;" \n
                         "    [_driver] orderGetIn true;" \n
                         "    _wp = _group addWaypoint [getMarkerPos ""carEvac"", 0];" \n
                         "    _wp setWaypointType ""MOVE"";" \n
                         "    _wp setWaypointSpeed ""FULL"";" \n
                         "    _wp setWaypointCombatMode ""BLUE"";" \n
                         "} else {" \n
                         "	// car is destroyed, make SAD wp" \n
                         "	_wp = _group addWaypoint [(getPosATL _driver), 0];" \n
                         "   _wp setWaypointType ""SAD"";" \n
                         "	_group setBehaviour ""Combat"";  " \n
                         "}"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "KIA">*/
                                class KIA
                                {
                                        itemno = 14;
                                        priority = 0.000000;
                                        to="end";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!alive _x"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
        };
        initState="start";
