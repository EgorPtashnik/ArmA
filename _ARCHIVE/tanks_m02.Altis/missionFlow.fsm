                class Destroy_NATO_FOB
                {
                        name = "Destroy_NATO_FOB";
                        itemno = 8;
                        init = /*%FSM<STATEINIT""">*/"[] spawn {" \n
                         "	""FOB_Found"" call BIS_fnc_missionConversations;" \n
                         "	sleep 5;" \n
                         "	[""BIS_tskFOBFind"",""Succeeded""] call BIS_fnc_missionTasks;" \n
                         "	[""BIS_tskFOBDestroy"",""Current""] call BIS_fnc_missionTasks;" \n
                         "	BIS_Support_Infantry02 = [BIS_ARPlayer,""Infantry02""] call BIS_fnc_addCommMenuItem;" \n
                         "	""BIS_mrkFOB"" setMarkerAlpha 1;" \n
                         "	""BIS_mrkFOBArea"" setMarkerAlpha 0;" \n
                         "	""BIS_mrkInfantryN"" setMarkerAlpha 1;" \n
                         "	resistance reportRemoteTarget [BIS_Wiesel03,9999];" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Armata_KO">*/
                                class Armata_KO
                                {
                                        itemno = 11;
                                        priority = 20.000000;
                                        to="FAIL_02";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(damage BIS_Armata == 1) and" \n
                                         "{(alive BIS_ARPlayer)}" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Disobeying_order">*/
                                class Disobeying_order
                                {
                                        itemno = 10;
                                        priority = 15.000000;
                                        to="FAIL_01";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"BIS_Fail" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
