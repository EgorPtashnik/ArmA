                /*%FSM</STATE>*/
                /*%FSM<STATE "Prologue">*/
                class Prologue
                {
                        name = "Prologue";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"[] spawn {" \n
                         "	BIS_Mortar setVariable [""BIS_SUPP_useDefaultBurst"",4];" \n
                         "	""Prologue"" call BIS_fnc_missionConversations;" \n
                         "	sleep 3;" \n
                         "	""Info"" call BIS_fnc_missionConversations;" \n
                         "	sleep 3;" \n
                         "	BIS_Support_Infantry01 = [BIS_ARPlayer,""Infantry01""] call BIS_fnc_addCommMenuItem;" \n
                         "	sleep 3;" \n
                         "	BIS_Support_Armor = [BIS_ARPlayer,""Armor""] call BIS_fnc_addCommMenuItem;" \n
                         "	sleep 3;" \n
                         "	BIS_Support_Wiesel = [BIS_ARPlayer,""Wiesel""] call BIS_fnc_addCommMenuItem;" \n
                         "	sleep 3;" \n
                         "	BIS_MortarModule synchronizeObjectsAdd [BIS_ARPlayer];" \n
                         "	sleep 10;" \n
                         "	""StreetFighting"" call BIS_fnc_missionConversations;" \n
                         "	// sleep 10;" \n
                         "	// 2 call BIS_fnc_earthquake;" \n
                         "	// ""Earthquake_01"" call BIS_fnc_missionConversations;" \n
                         "};" \n
                         "" \n
                         "[] spawn {" \n
                         "	// playMusic ""LeadTrack03_F_EXP"";" \n
                         "	0 fadeMusic 0;" \n
                         "	sleep 3.25;" \n
                         "	playMusic ""LeadTrack01_F_Tank"";" \n
                         "	8 fadeMusic 0.5;" \n
                         "	/*sleep 65;" \n
                         "	10 fadeMusic 0;" \n
                         "	sleep 12;" \n
                         "	playMusic """";" \n
                         "	0 fadeMusic 0.5;*/" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Armata_KO">*/
                                class Armata_KO
                                {
                                        itemno = 11;
                                        priority = 20.000000;
                                        to="FAIL_02";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(damage BIS_Armata == 1) and" \n
                                         "{(alive BIS_ARPlayer)}" \n
                                         ""/*%FSM</CONDITION""">*/;
