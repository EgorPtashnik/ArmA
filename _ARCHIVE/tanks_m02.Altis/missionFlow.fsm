                                        to="NATO_Retreat";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(""BIS_tskFOBDestroy"" call BIS_fnc_taskExists) and" \n
                                         "{(BIS_FOBRetreat)}" \n
                                         ""/*%FSM</CONDITION""">*/;
