                                class Dorida_freed
                                {
                                        itemno = 3;
                                        priority = 0.000000;
                                        to="Find_NATO_FOB";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(BIS_DoridaFree) and" \n
                                         "({!(canMove _x) and !(canFire _x)} forEach [BIS_Rooikat01,BIS_AMV01,BIS_AMV02])" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Too_close_to_FOB">*/
                                class Too_close_to_FOB
                                {
                                        itemno = 27;
                                        priority = 0.000000;
                                        to="Warning";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(vehicle BIS_ARPlayer) distance2D BIS_FOB < 1500" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Find_NATO_FOB">*/
                class Find_NATO_FOB
                {
                        name = "Find_NATO_FOB";
                        itemno = 4;
                        init = /*%FSM<STATEINIT""">*/"/*" \n
                         "// Send the supporting Wiesel to the city right away, else one will have to way for too long" \n
                         "BIS_grpWiesel03 copyWaypoints BIS_grpWiesel03WP;" \n
                         "BIS_Wiesel03 setPos (getMarkerPos ""BIS_mrkWieselPos"");" \n
                         "*/" \n
                         "" \n
                         "[] spawn {" \n
                         "	sleep 45;" \n
                         "	// Conversation after city was captured" \n
                         "	""City_Captured""  call BIS_fnc_missionConversations;" \n
                         "" \n
                         "	// Remove supports if unused" \n
                         "	if !(BIS_Supp_Infantry01) then {[BIS_ARPlayer,BIS_Support_Infantry01] call BIS_fnc_removeCommMenuItem; BIS_grpInfSouth copyWaypoints BIS_grpSWP;};" \n
                         "	if !(BIS_Supp_Armor) then {[BIS_ARPlayer,BIS_Support_Armor] call BIS_fnc_removeCommMenuItem; BIS_grpLeopard copyWaypoints BIS_grpLeopardWP;};" \n
                         "	if !(BIS_Supp_Wiesel) then {[BIS_ARPlayer,BIS_Support_Wiesel] call BIS_fnc_removeCommMenuItem; BIS_grpWiesel01 copyWaypoints BIS_grpWiesel01WP; BIS_grpWiesel02 copyWaypoints BIS_grpWiesel02WP;};" \n
                         "/*" \n
                         "	// If the Wiesel and its crew survived, player can take direct command + send it close to city" \n
                         "	if ((damage BIS_Wiesel03 < 1) and (alive BIS_WieselCrew05) and (alive BIS_WieselCrew06)) then {" \n
                         "		{_x setDamage 0} forEach [BIS_Wiesel03,BIS_WieselCrew05,BIS_WieselCrew06];" \n
                         "		""WieselOK"" call BIS_fnc_missionConversations;" \n
                         "		BIS_WieselAvailable = true;" \n
                         "		BIS_Support_WieselJoin = [BIS_Player,""WieselJoin""] call BIS_fnc_addCommMenuItem;" \n
                         "	} else {" \n
                         "		""WieselKO"" call BIS_fnc_missionConversations;" \n
                         "	};" \n
                         "*/" \n
                         "	// Succeed task, add new" \n
                         "	[""BIS_tskDorida"",""Succeeded""] call BIS_fnc_missionTasks;" \n
                         "	[""BIS_tskFOBFind"",""Assigned""] call BIS_fnc_missionTasks;" \n
                         "	""BIS_mrkFOBArea"" setMarkerAlpha 1;" \n
                         "	sleep 10;" \n
                         "	// Save - the only one" \n
                         "	saveGame;" \n
                         "" \n
                         "	sleep 60 + (random 30);" \n
                         "	// Send the A10 to harass AAF" \n
                         "	BIS_A10 enableSimulation true;" \n
                         "	_null = BIS_A10 execFSM ""FSMs\Warthog.fsm"";" \n
                         "/*" \n
                         "	sleep 30 + (random 30);" \n
                         "	// Second and last earthquake" \n
                         "	3 spawn BIS_fnc_earthquake;" \n
                         "	sleep 2.5;" \n
                         "	""Earthquake_02"" call BIS_fnc_missionConversations;" \n
                         "*/" \n
                         "};" \n
                         "" \n
                         "// Enable simulation to remaining AAF units" \n
                         "{_x enableSimulation true} forEach (units BIS_grpInfNorth + units BIS_grpWiesel03);" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Armata_KO">*/
                                class Armata_KO
                                {
                                        itemno = 11;
                                        priority = 20.000000;
                                        to="FAIL_02";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(damage BIS_Armata == 1) and" \n
                                         "{(alive BIS_ARPlayer)}" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Disobeying_order">*/
                                class Disobeying_order
                                {
                                        itemno = 10;
                                        priority = 15.000000;
                                        to="FAIL_01";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"BIS_Fail" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Found">*/
                                class Found
                                {
                                        itemno = 7;
                                        priority = 0.000000;
                                        to="Destroy_NATO_FOB";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(""BIS_tskFOBFind"" call BIS_fnc_taskExists) and" \n
                                         "{(BIS_FOBFound or ((vehicle BIS_ARPlayer) distance2D BIS_FOB < 125))}" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "End_01_02">*/
                class End_01_02
                {
                        name = "End_01_02";
                        itemno = 6;
                        init = /*%FSM<STATEINIT""">*/"[] spawn {" \n
                         "	sleep 5;" \n
                         "	""FOB_Destroyed"" call BIS_fnc_missionConversations;" \n
                         "	[""BIS_tskFOBDestroy"",""Succeeded""] call BIS_fnc_missionTasks;" \n
                         "" \n
                         "	sleep 2.5;" \n
                         "	// this variable triggers end of CollateralDamage.fsm" \n
                         "	BIS_End = true;" \n
                         "	sleep 5;" \n
                         "	if (BIS_CollateralDamage < BIS_CollateralDamageFailLimit) then {" \n
                         "		if ((isNil {profileNamespace getVariable ""BIS_Tanks_LimitedDamage""}) or (profileNamespace getVariable ""BIS_Tanks_LimitedDamage"" != 0)) then {" \n
                         "			profileNamespace setVariable [""BIS_Tanks_LimitedDamage"",1]" \n
                         "		};" \n
                         "		[""Win01"",true,true,true,true] call BIS_fnc_endMission;" \n
                         "	} else {" \n
                         "		profileNamespace setVariable [""BIS_Tanks_LimitedDamage"",0];" \n
                         "		[""Win02"",true,true,true,true] call BIS_fnc_endMission;" \n
                         "	};" \n
                         "};" \n
                         "" \n
                         "// if !(BIS_Infantry02_called) then {[BIS_ARPlayer,BIS_Support_Infantry02] call BIS_fnc_removeCommMenuItem;};" \n
                         "// if (BIS_WieselAvailable and !(BIS_Supp_WieselJoin)) then {[BIS_ARPlayer,BIS_Support_WieselJoin] call BIS_fnc_removeCommMenuItem;};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
