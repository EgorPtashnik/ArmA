                /*%FSM<STATE "Destroy_Armata">*/
                class Destroy_Armata
                {
                        name = "Destroy_Armata";
                        itemno = 11;
                        init = /*%FSM<STATEINIT""">*/"_t = time;" \n
                         "" \n
                         "BIS_Armata addEventHandler [""Killed"",{if ((_this select 1 == (vehicle BIS_ARPlayer))) then {BIS_ARPlayer addRating 15000}}];" \n
                         "" \n
                         "BIS_grpPanagia01 copyWaypoints BIS_grpPanagiaRetreatWP;" \n
                         "BIS_grpPanagia02 copyWaypoints BIS_grpPanagiaRetreatWP;" \n
                         "BIS_grpCommanche copyWaypoints BIS_grpHeliRetreatWP;" \n
                         "" \n
                         "[] spawn {" \n
                         "	sleep 5;" \n
                         "	// Kill crews of NATO vehicles" \n
                         "	{_x setDamage 1} forEach (units BIS_grpRooikat03 + units BIS_grpTanks03 + units BIS_grpMarshall01);" \n
                         "	sleep 5;" \n
                         "	[""BIS_tskPanagia"",""Succeeded""] call BIS_fnc_missionTasks;" \n
                         "	BIS_Armata addMagazineCargo [""DemoCharge_Remote_Mag"",2];" \n
                         "	BIS_Armata addMagazineCargo [""SatchelCharge_Remote_Mag"",2];" \n
                         "	BIS_Armata addEventHandler [""HandleDamage"",{if ((_this select 4) in [""DemoCharge_Remote_Ammo"",""SatchelCharge_Remote_Ammo""]) then {1}}];" \n
                         "	0 fadeMusic 0;" \n
                         "	playMusic ""LeadTrack03_F_Tank"";" \n
                         "	5 fadeMusic 0.5;" \n
                         "	""PanagiaHelped"" call BIS_fnc_missionConversations;" \n
                         "	sleep 1;" \n
                         "	[""BIS_tskDestroyArmata"",""Current""] call BIS_fnc_missionTasks;" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
