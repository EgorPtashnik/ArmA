                /*%FSM</STATE>*/
                /*%FSM<STATE "Variables___FSMs">*/
                class Variables___FSMs
                {
                        name = "Variables___FSMs";
                        itemno = 36;
                        init = /*%FSM<STATEINIT""">*/"_t = time;" \n
                         "" \n
                         "{_x allowFleeing 0} forEach allUnits;" \n
                         "{_x allowCrewInImmobile true} forEach (allMissionObjects ""tank"");" \n
                         "" \n
                         "BIS_Infantry = false;" \n
                         "BIS_Defeated = false;" \n
                         "BIS_Defended = false;" \n
                         "BIS_HQSaved = false;" \n
                         "BIS_Wave01 = false;" \n
                         "BIS_Wave02 = false;" \n
                         "BIS_Wave03 = false;" \n
                         "BIS_Fail = false;" \n
                         "BIS_End = false;" \n
                         "BIS_ArmorKill01 = false;" \n
                         "BIS_ArmorKill02 = false;" \n
                         "BIS_SendHeli = false;" \n
                         "" \n
                         """BIS_mrkEastAttack"" setMarkerAlpha 0;" \n
                         "{_x disableAI ""autocombat""} forEach allUnits;" \n
                         "" \n
                         "{_x enableSimulation false} forEach (units BIS_grpTanks01 + units BIS_grpTanks02 + units BIS_grpTanks03 + units BIS_grpRooikat03 + units BIS_grpMarshall01 + units BIS_grpCommanche + units BIS_grpPanagia01 + units BIS_grpPanagia02 + units BIS_grpPanagia03);" \n
                         "{_x enableSimulation false} forEach [BIS_Cheetah01,BIS_Slammer01,BIS_Slammer02,BIS_Slammer03,BIS_Slammer04,BIS_Slammer05,BIS_Slammer06,BIS_Rooikat03,BIS_Marshall01,BIS_Commanche];" \n
                         "" \n
                         "// Make air vehicles captive from the beginning - they are spawned via CAS modules" \n
                         "[] spawn {" \n
                         "	{_x setCaptive true} forEach (allMissionObjects ""air"");" \n
                         "	sleep 75;" \n
                         "	{_x setCaptive false} forEach (allMissionObjects ""air"");" \n
                         "};" \n
                         "" \n
                         "// Exec all the FSMs" \n
                         "[] execFSM ""FSMs\AO.fsm"";" \n
                         "[] execFSM ""FSMs\Armata.fsm"";" \n
                         "[] execFSM ""FSMs\Offensive.fsm"";" \n
                         "[] execFSM ""FSMs\RepairControl.fsm"";" \n
                         "" \n
                         "// Disable rabbits and snakes" \n
                         "[] spawn {" \n
                         "	waitUntil {time > 0};" \n
                         "	enableEnvironment [false, true];" \n
                         "};" \n
                         "" \n
                         "// Conversation after being hit" \n
                         "_hit = BIS_ARPlayer addEventHandler [""Hit"",{if (_this select 2 > 0.2) then {""Injured"" spawn BIS_fnc_missionConversations}}];" \n
                         "" \n
                         "// Kill confirmation conversations" \n
                         "[] spawn {" \n
                         "	waitUntil {sleep 1; BIS_ArmorKill01};" \n
                         "	""EnemyTankKIA01"" call BIS_fnc_missionConversations;" \n
                         "};" \n
                         "" \n
                         "[] spawn {" \n
                         "	waitUntil {sleep 1; BIS_ArmorKill02};" \n
                         "	""EnemyTankKIA02"" call BIS_fnc_missionConversations;" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
