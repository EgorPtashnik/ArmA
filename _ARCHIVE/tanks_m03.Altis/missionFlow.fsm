                                        to="Destroy_Armata";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"({(canFire _x) and (canMove _x)} count [" \n
                                         "	BIS_Marshall01," \n
                                         "	BIS_Rooikat03," \n
                                         "	BIS_Slammer06" \n
                                         "] == 0)" \n
                                         ""/*%FSM</CONDITION""">*/;
