                /*%FSM<STATE "__WIN__03">*/
                class __WIN__03
                {
                        name = "__WIN__03";
                        itemno = 13;
                        init = /*%FSM<STATEINIT""">*/"[] spawn {" \n
                         "	""DefenseFailed"" call BIS_fnc_missionConversations;" \n
                         "	[""BIS_tskDefense"",""Canceled""] call BIS_fnc_missionTasks;" \n
                         "	sleep 5;" \n
                         "	if ((damage BIS_Armata == 1) and (damage BIS_Tank == 1)) then {" \n
                         "		profileNamespace setVariable [""BIS_Tanks_ArmataKO"",1]" \n
                         "	} else {" \n
                         "		profileNamespace setVariable [""BIS_Tanks_ArmataKO"",0]" \n
                         "	};" \n
                         "	profileNamespace setVariable [""BIS_Tanks_Victory"",0];" \n
                         "	[""Win03"",true,true,true,true] call BIS_fnc_endMission;" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
