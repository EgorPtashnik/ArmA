                {
                        name = "WIN_01_02";
                        itemno = 16;
                        init = /*%FSM<STATEINIT""">*/"// Set variables for outro - AAF won this battle" \n
                         "profileNamespace setVariable [""BIS_Tanks_Victory"",1];" \n
                         "" \n
                         "// Fade out music" \n
                         "// 10 fadeMusic 0;" \n
                         "" \n
                         "// End depends on if any of the Armata survived" \n
                         "if ((damage BIS_Armata == 1) and (damage BIS_Tank == 1)) then {" \n
                         "	profileNamespace setVariable [""BIS_Tanks_ArmataKO"",1];" \n
                         "	[""Win01"",true,true,false,true] call BIS_fnc_endMission;" \n
                         "} else {" \n
                         "	profileNamespace setVariable [""BIS_Tanks_ArmataKO"",0];" \n
                         "	[""Win02"",true,true,false,true] call BIS_fnc_endMission;" \n
