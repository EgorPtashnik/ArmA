                {
                        name = "Report_1";
                        itemno = 20;
                        init = /*%FSM<STATEINIT""">*/"[] spawn {" \n
                         "	[""BIS_tskDefense"",""Succeeded""] call BIS_fnc_missionTasks;" \n
                         "	if ({alive _x} count (units group BIS_ARPlayer) > 1) then {" \n
                         "		""Defended"" call BIS_fnc_missionConversations;" \n
                         "	} else {" \n
                         "		""DefendedAlone"" call BIS_fnc_missionConversations;" \n
                         "	};" \n
                         "	sleep 1;" \n
                         "	""PanagiaSituation"" call BIS_fnc_missionConversations;" \n
                         "	sleep 1;" \n
                         "	""ArmataDestroyed"" call BIS_fnc_missionConversations;" \n
                         "	sleep 1;" \n
                         "	""ArmataDestroyedSurrender"" call BIS_fnc_missionConversations;" \n
                         "	BIS_End = true;" \n
                         "};" \n
