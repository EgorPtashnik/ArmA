                /*%FSM<STATE "Help_at_Panagia">*/
                class Help_at_Panagia
                {
                        name = "Help_at_Panagia";
                        itemno = 61;
                        init = /*%FSM<STATEINIT""">*/"[] spawn {" \n
                         "	// Destroy AAF vehicles at the eastern front" \n
                         "	{_x enableSimulation true} forEach [BIS_Pandur,BIS_Leopard,BIS_Kamaz01,BIS_Kamaz02];" \n
                         "	{_x setDamage 1} forEach [BIS_Pandur,BIS_Leopard,BIS_Kamaz01,BIS_Kamaz02];" \n
                         "	[""BIS_tskDefense"",""Succeeded""] call BIS_fnc_missionTasks;" \n
                         "	if ({alive _x} count (units group BIS_ARPlayer) > 1) then {" \n
                         "		""Defended"" call BIS_fnc_missionConversations;" \n
                         "	} else {" \n
                         "		""DefendedAlone"" call BIS_fnc_missionConversations;" \n
                         "	};" \n
                         "	sleep 1.5;" \n
                         "	""PanagiaSituation"" call BIS_fnc_missionConversations;" \n
                         "	sleep 1;" \n
                         "	""ArmataSurvived"" call BIS_fnc_missionConversations;" \n
                         "	[""BIS_tskPanagia"",""Current""] call BIS_fnc_missionTasks;" \n
                         "" \n
                         "	// Second savegame" \n
                         "	sleep 7.5;" \n
                         "	saveGame;" \n
                         "" \n
                         "	// Enable simulation for units in Panagia" \n
                         "	{_x enableSimulation true} forEach (units BIS_grpRooikat03 + units BIS_grpTanks03 + units BIS_grpMarshall01 + units BIS_grpCommanche + units BIS_grpPanagia01 + units BIS_grpPanagia02 + units BIS_grpPanagia03);" \n
                         "	{_x enableSimulation true} forEach [BIS_Rooikat03,BIS_Slammer06,BIS_Marshall01,BIS_Commanche];" \n
                         "" \n
                         "	{_x setPos (getMarkerPos ""BIS_mrkPanaGroup01"")} forEach (units BIS_grpPanagia01);" \n
                         "	{_x setPos (getMarkerPos ""BIS_mrkPanaGroup02"")} forEach (units BIS_grpPanagia02);" \n
                         "	{_x setPos (getMarkerPos ""BIS_mrkPanaGroup03"")} forEach (units BIS_grpPanagia03);" \n
                         "" \n
                         "	BIS_grpPanagia01 copyWaypoints BIS_grpPanagiaWP01;" \n
                         "	BIS_grpPanagia02 copyWaypoints BIS_grpPanagiaWP02;" \n
                         "	BIS_grpPanagia03 copyWaypoints BIS_grpPanagiaWP03;" \n
                         "" \n
                         "	// Make Slammer suppress 'AAF' positions" \n
                         "	BIS_Slammer06 setPos getMarkerPos ""BIS_mrkSuppressorPos"";" \n
                         "	BIS_Slammer06 setDir 130;" \n
                         "	_null = [BIS_Slammer06,[BIS_SuppTarget01,BIS_SuppTarget02,BIS_SuppTarget03,BIS_SuppTarget04,BIS_SuppTarget05]] execFSM ""FSMs\SuppressiveFire.fsm"";" \n
                         "" \n
                         "	// Make Rooikat roam Panagia" \n
                         "	BIS_Rooikat03 setPos getMarkerPos ""BIS_mrkRoamerPos"";" \n
                         "	BIS_grpRooikat03 copyWaypoints BIS_grpPanagiaWP;" \n
                         "" \n
                         "	// Send Marshall to 'hunt' for player" \n
                         "	BIS_Marshall01 setPos getMarkerPos ""BIS_mrkStalkerPos"";" \n
                         "	BIS_Marshall01 setDir 230;" \n
                         "	BIS_grpMarshall01 setBehaviour ""Combat"";" \n
                         "	_stalking = [BIS_grpMarshall01,(group BIS_ARPlayer),nil,50] spawn BIS_fnc_stalk;" \n
                         "" \n
                         "	// Send Commanche to attack Panagia" \n
                         "	BIS_grpCommanche copyWaypoints BIS_grpHeliWP;" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Disobeying_order">*/
                                class Disobeying_order
                                {
                                        itemno = 26;
                                        priority = 15.000000;
                                        to="FAIL_01";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"BIS_Fail" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Armata_KO">*/
                                class Armata_KO
                                {
                                        itemno = 63;
                                        priority = 1.000000;
                                        to="__WIN__03_1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(damage BIS_Armata == 1) and" \n
                                         "{(alive BIS_ARPlayer)} and" \n
                                         "{(""BIS_tskPanagia"" call BIS_fnc_taskExists)}" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
