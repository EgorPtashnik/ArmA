                /*%FSM<STATE "__nd_wave">*/
                class __nd_wave
                {
                        name = "__nd_wave";
                        itemno = 4;
                        init = /*%FSM<STATEINIT""">*/"_t = time;" \n
                         "" \n
                         "BIS_Wave02 = true;" \n
                         "" \n
                         "[] spawn {" \n
                         "	sleep 40;" \n
                         "	_barrageEast02 = [""BIS_mrkEast02"",""Sh_82mm_AMOS"",200,20,[4,6]] spawn BIS_fnc_fireSupportVirtual;" \n
                         "	""ETanksDestroyed"" call BIS_fnc_missionConversations;" \n
                         "	sleep 20;" \n
                         "	""ArtemisDestroyed"" call BIS_fnc_missionConversations;" \n
                         "};" \n
                         "/*" \n
                         "[] spawn {" \n
                         "	sleep 100;" \n
                         "	BIS_Armor05 setPos (getMarkerPos ""BIS_mrkAAPos"");" \n
                         "	(group (driver BIS_Armor05)) copyWaypoints BIS_grpAAWP;" \n
                         "};" \n
                         "*/" \n
                         ""/*%FSM</STATEINIT""">*/;
