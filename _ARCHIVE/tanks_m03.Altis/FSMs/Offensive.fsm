                /*%FSM<STATE "__st_wave">*/
                class __st_wave
                {
                        name = "__st_wave";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"_t = time;" \n
                         "" \n
                         "[] spawn {" \n
                         "	// {_x enableSimulation true} forEach [BIS_A10_01,BIS_A10_01Pilot,BIS_A10_02,BIS_A10_02Pilot,BIS_A10_03,BIS_A10_03Pilot];" \n
                         "	// _null = BIS_A10_01 execFSM ""FSMs\Warthog.fsm"";" \n
                         "	// _null = BIS_A10_02 execFSM ""FSMs\Warthog.fsm"";" \n
                         "	// _null = BIS_A10_03 execFSM ""FSMs\Warthog.fsm"";" \n
                         "" \n
                         "	// (group BIS_A10_01Pilot) copyWaypoints BIS_grpJetAttack;" \n
                         "	// (group BIS_A10_02Pilot) copyWaypoints BIS_grpJetAttack;" \n
                         "	// (group BIS_A10_03Pilot) copyWaypoints BIS_grpJetAttack;" \n
                         "" \n
                         "	""ETanksSpotted"" call BIS_fnc_missionConversations;" \n
                         "	BIS_Infantry = true;" \n
                         "	BIS_Victim01 setDamage 1;" \n
                         "	sleep 15;" \n
                         "	BIS_Victim02 setDamage 1;" \n
                         "	BIS_Wave01 = true;" \n
                         "	sleep 15;" \n
                         "	// {_x setMarkerColor ""ColorGrey""} forEach [""BIS_mrkInfantry01"",""BIS_mrkInfantry02"",""BIS_mrkInfantry03""];" \n
                         "	""Passed"" call BIS_fnc_missionConversations;" \n
                         "	sleep 5;" \n
                         "	// First savegame" \n
                         "	saveGame;" \n
                         "	sleep 10;" \n
                         "	""Incoming"" call BIS_fnc_missionConversations;" \n
                         "	sleep 1;" \n
                         "	// Mortar at the first defense line" \n
                         "	_barrage03 = [""BIS_mrkLine01"",""Sh_82mm_AMOS"",200,12,[4,6],nil,30,nil,nil,[""mortar1"",""mortar2""]] spawn BIS_fnc_fireSupportVirtual;" \n
                         "	// Mortar at player's position - with a safezone" \n
                         "	_barrage04 = [(vehicle BIS_ARPlayer),""Sh_82mm_AMOS"",75,4,[2,3],nil,50,nil,nil,[""mortar1"",""mortar2""]] spawn BIS_fnc_fireSupportVirtual;" \n
                         "	// Mortar smoke to cover AFVs approach" \n
                         "	_barrageSmoke = [""BIS_mrkSmoke"",""Smoke_82mm_AMOS_White"",35,8,[4,6]] spawn BIS_fnc_fireSupportVirtual;" \n
                         "	// Mortar barrage at the eastern line" \n
                         "	_barrageEast01 = [""BIS_mrkEast02"",""Sh_82mm_AMOS"",200,40,[4,6]] spawn BIS_fnc_fireSupportVirtual;" \n
                         "" \n
                         "	// Create laser target at player's vehicle to get some clusters" \n
                         "	// BIS_Laser = ""LaserTargetW"" createVehicle [10,10,10];" \n
                         "	// BIS_Laser attachTo [BIS_Tank,[0,-1.75,0.25]];" \n
                         "" \n
                         "	sleep 10;" \n
                         "	// Aerial bombardment 01 - Brrrrrrt x2" \n
                         "	_logic01 = createagent [""Logic"",getMarkerPos ""BIS_mrkAirRaid01"",[],0,""none""];" \n
                         "	_logic01 setDir 90;" \n
                         "	_logic01 setVariable [""Type"",0];" \n
                         "	_logic01 setVariable [""Vehicle"",""B_Plane_CAS_01_F""];" \n
                         "	_cas01 = [_logic01,[],true] spawn bis_fnc_moduleCAS;" \n
                         "" \n
                         "	sleep 5;" \n
                         "	_logic02 = createagent [""Logic"",getMarkerPos ""BIS_mrkAirRaid02"",[],0,""none""];" \n
                         "	_logic02 setDir 95;" \n
                         "	_logic02 setVariable [""Type"",0];" \n
                         "	_logic02 setVariable [""Vehicle"",""B_Plane_CAS_01_F""];" \n
                         "	_cas02 = [_logic02,[],true] spawn bis_fnc_moduleCAS;" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
