                class END
                {
                        name = "END";
                        itemno = 8;
                        init = /*%FSM<STATEINIT""">*/"[] spawn {" \n
                         "	sleep 5;" \n
                         "	{_x setDamage 1} forEach (" \n
                         "		units BIS_grpRooikat01 +" \n
                         "		units BIS_grpRooikat02 +" \n
                         "		units BIS_grpTanks01 +" \n
                         "		units BIS_grpTanks02" \n
