                /*%FSM<STATE "__rd_wave">*/
                class __rd_wave
                {
                        name = "__rd_wave";
                        itemno = 6;
                        init = /*%FSM<STATEINIT""">*/"_t = time;" \n
                         "" \n
                         "{_x enableSimulation true} forEach (units BIS_grpArmor00);" \n
                         "{_x enableSimulation true} forEach [BIS_Armor0C,BIS_Armor0D];" \n
                         "" \n
                         "BIS_Armor0C setPos (getMarkerPos ""BIS_mrkArmorPos01"");" \n
                         "BIS_Armor0D setPos (getMarkerPos ""BIS_mrkArmorPos02"");" \n
                         "" \n
                         "[] spawn {" \n
                         "	sleep 40;" \n
                         "	BIS_grpArmor00 copyWaypoints BIS_grpEasternAttackWP;" \n
                         "	""EnemyFlanking"" spawn BIS_fnc_missionConversations;" \n
                         "	{_x setMarkerColor ""ColorGrey""} forEach [""BIS_mrkEast01"",""BIS_mrkEast02""];" \n
                         "	{_x setMarkerAlpha 1} forEach [""BIS_mrkEastAttack01"",""BIS_mrkEastAttack02""];" \n
                         "	// sleep 30;" \n
                         "	// Aerial bombardment 02 - Cluster" \n
                         "	_logic03 = createagent [""Logic"",getMarkerPos ""BIS_mrkAirRaid03"",[],0,""none""];" \n
                         "	_logic03 setDir 85;" \n
                         "	_logic03 setVariable [""Type"",3];" \n
                         "	_logic03 setVariable [""Vehicle"",""B_Plane_CAS_01_Cluster_F""];" \n
                         "	_cas03 = [_logic03,[],true] spawn bis_fnc_moduleCAS;" \n
                         "	// mortar barrage at the second defense line" \n
                         "	// _barrage05 = [""BIS_mrkLine02"",""Sh_82mm_AMOS"",200,12,[4,6],nil,nil,nil,nil,[""mortar1"",""mortar2""]] spawn BIS_fnc_fireSupportVirtual;" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
