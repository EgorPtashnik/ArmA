                        class Links
                        {
                                /*%FSM<LINK "Timeout_or_2nd_wave">*/
                                class Timeout_or_2nd_wave
                                {
                                        itemno = 5;
                                        priority = 0.000000;
                                        to="__rd_wave";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(time > _t + 120) or" \n
                                         "({(canFire _x) and (canMove _x)} count [" \n
                                         "	BIS_Armor0A," \n
                                         "	BIS_Armor0B," \n
                                         "	BIS_Armor01," \n
                                         "	BIS_Armor02," \n
                                         "	BIS_Armor03," \n
                                         "	BIS_Armor04," \n
                                         "	BIS_Armor05" \n
                                         "] == 0)" \n
