                /*%FSM</STATE>*/
                /*%FSM<STATE "Wave__01">*/
                class Wave__01
                {
                        name = "Wave__01";
                        itemno = 9;
                        init = /*%FSM<STATEINIT""">*/"_t = time;" \n
                         "" \n
                         "[] spawn {" \n
                         "/*" \n
                         "	// Aerial bombardment 01 - Brrrrrrt x2" \n
                         "	_logic01 = createagent [""Logic"",getMarkerPos ""BIS_mrkAirRaid01"",[],0,""none""];" \n
                         "	_logic01 setDir 90;" \n
                         "	_logic01 setVariable [""Type"",0];" \n
                         "	_logic01 setVariable [""Vehicle"",""B_Plane_CAS_01_F""];" \n
                         "	_cas01 = [_logic01,[],true] spawn bis_fnc_moduleCAS;" \n
                         "" \n
                         "	sleep 5;" \n
                         "	_logic02 = createagent [""Logic"",getMarkerPos ""BIS_mrkAirRaid02"",[],0,""none""];" \n
                         "	_logic02 setDir 95;" \n
                         "	_logic02 setVariable [""Type"",0];" \n
                         "	_logic02 setVariable [""Vehicle"",""B_Plane_CAS_01_F""];" \n
                         "	_cas02 = [_logic02,[],true] spawn bis_fnc_moduleCAS;" \n
                         "*/" \n
                         "	// Slammers and Cheetah moving to the first line" \n
                         "" \n
                         "	BIS_Slammer01 setPos (getMarkerPos ""BIS_mrkTankPos01"");" \n
                         "	BIS_Slammer02 setPos (getMarkerPos ""BIS_mrkTankPos02"");" \n
                         "	BIS_Slammer03 setPos (getMarkerPos ""BIS_mrkTankPos03"");" \n
                         "	BIS_Cheetah01 setPos (getMarkerPos ""BIS_mrkTankPos04"");" \n
                         "" \n
                         "	{_x enableSimulation true} forEach [BIS_Cheetah01,BIS_Slammer01,BIS_Slammer02,BIS_Slammer03];" \n
                         "	{_x enableSimulation true} forEach (units BIS_grpTanks01);" \n
                         "" \n
                         "	BIS_SendMBT = true;" \n
                         "	_mgsTime = time;" \n
                         "" \n
                         "	// Rooikats moving to the hilltop" \n
                         "	waitUntil {!(isNil {BIS_SendMGS}) or (time > _mgsTime + 75)};" \n
                         "	sleep 15 + (random 10);" \n
                         "	BIS_Rooikat01 setPos (getMarkerPos ""BIS_mrkRooikat01Pos"");" \n
                         "	BIS_Rooikat02 setPos (getMarkerPos ""BIS_mrkRooikat02Pos"");" \n
                         "	BIS_grpRooikat01 copyWaypoints BIS_grpRooikat01WP;" \n
                         "	BIS_grpRooikat02 copyWaypoints BIS_grpRooikat02WP;" \n
                         "	{(leader BIS_grpRooikat01) reveal _x} forEach (units BIS_grpFirstLine);" \n
                         "	{(leader BIS_grpRooikat02) reveal _x} forEach (units BIS_grpFirstLine);" \n
                         "" \n
                         "	// Aerial attack" \n
                         "	{_x enableSimulation true} forEach [BIS_A10_01,BIS_A10_01Pilot,BIS_A10_02,BIS_A10_02Pilot];" \n
                         "	_null = BIS_A10_01 execFSM ""FSMs\Warthog.fsm"";" \n
                         "	_null = BIS_A10_02 execFSM ""FSMs\Warthog.fsm"";" \n
                         "" \n
                         "	(group BIS_A10_01Pilot) copyWaypoints BIS_grpJetAttack;" \n
                         "	(group BIS_A10_02Pilot) copyWaypoints BIS_grpJetAttack;" \n
                         "};" \n
                         "/*" \n
                         "[] spawn {" \n
                         "	// Confirm enemy vehicles as remote targets" \n
                         "	sleep 20;" \n
                         "	resistance reportRemoteTarget [BIS_Slammer01,9999];" \n
                         "	BIS_Slammer01 confirmSensorTarget [resistance,true];" \n
                         "	sleep 2 + (random 2);" \n
                         "	resistance reportRemoteTarget [BIS_Slammer02,9999];" \n
                         "	BIS_Slammer02 confirmSensorTarget [resistance,true];" \n
                         "	sleep 2 + (random 2);" \n
                         "	resistance reportRemoteTarget [BIS_Slammer03,9999];" \n
                         "	BIS_Slammer03 confirmSensorTarget [resistance,true];" \n
                         "	sleep 2 + (random 2);" \n
                         "	resistance reportRemoteTarget [BIS_Cheetah01,9999];" \n
                         "	BIS_Cheetah01 confirmSensorTarget [resistance,true];" \n
                         "	waitUntil {!(isNil {BIS_SendMGS})};" \n
                         "	resistance reportRemoteTarget [BIS_Rooikat01,9999];" \n
                         "	BIS_Rooikat01 confirmSensorTarget [resistance,true];" \n
                         "	sleep 2;" \n
                         "	resistance reportRemoteTarget [BIS_Rooikat02,9999];" \n
                         "	BIS_Rooikat02 confirmSensorTarget [resistance,true];" \n
                         "};" \n
                         "*/" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Timeout_or_defea">*/
                                class Timeout_or_defea
                                {
                                        itemno = 10;
                                        priority = 0.000000;
                                        to="Wave__02";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(time > (_t + 240)) or" \n
                                         "({(canFire _x) and (canMove _x)} count [" \n
                                         "	BIS_Rooikat01," \n
                                         "	BIS_Rooikat02," \n
                                         "	BIS_Slammer01," \n
                                         "	BIS_Slammer02," \n
                                         "	BIS_Slammer03," \n
                                         "	BIS_Cheetah01" \n
                                         "] == 0)" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Wave__02">*/
                class Wave__02
                {
                        name = "Wave__02";
                        itemno = 11;
                        init = /*%FSM<STATEINIT""">*/"[] spawn {" \n
                         "	sleep 5;" \n
                         "	_barrageEast02 = [""BIS_mrkEast02"",""Sh_82mm_AMOS"",200,20,[4,6]] spawn BIS_fnc_fireSupportVirtual;" \n
                         "	""ETanksDestroyed"" call BIS_fnc_missionConversations;" \n
                         "	sleep 10;" \n
                         "	""ArtemisDestroyed"" call BIS_fnc_missionConversations;" \n
                         "	sleep 5;" \n
                         "	""EnemyFlanking"" spawn BIS_fnc_missionConversations;" \n
                         "	{_x setMarkerColor ""ColorGrey""} forEach [""BIS_mrkEast01"",""BIS_mrkEast02""];" \n
                         "	{_x setMarkerAlpha 1} forEach [""BIS_mrkEastAttack01"",""BIS_mrkEastAttack02""];" \n
                         "	{_x enableSimulation true} forEach [BIS_Slammer04,BIS_Slammer05];" \n
                         "	{_x enableSimulation true} forEach (units BIS_grpTanks02);" \n
                         "	BIS_Slammer04 setPos (getMarkerPos ""BIS_mrkArmorPos01"");" \n
                         "	BIS_Slammer05 setPos (getMarkerPos ""BIS_mrkArmorPos02"");" \n
                         "	BIS_grpTanks02 copyWaypoints BIS_grpEasternAttackWP;" \n
                         "" \n
                         "	//Safety mechanism to auto-destroy the MGS vehicles, in case they were missed" \n
                         "	//Delays to fake an actual AI attack on them" \n
                         "	sleep 15;" \n
                         "" \n
                         "	if ((canFire BIS_Rooikat01) || (canMove BIS_Rooikat01)) then {BIS_Rooikat01 setDamage 1;};" \n
                         "" \n
                         "	sleep 25;" \n
                         "" \n
                         "	if ((canFire BIS_Rooikat02) || (canMove BIS_Rooikat02)) then {BIS_Rooikat02 setDamage 1;};" \n
                         "" \n
                         "	// Aerial bombardment 02 - Cluster" \n
                         "/*" \n
                         "	_logic03 = createagent [""Logic"",getMarkerPos ""BIS_mrkAirRaid03"",[],0,""none""];" \n
                         "	_logic03 setDir 85;" \n
