        class States
        {
                /*%FSM<STATE "Start">*/
                class Start
                {
                        name = "Start";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"_t = time;" \n
                         "" \n
                         "[] spawn {" \n
                         "	sleep 30;" \n
                         "	// Mortar fire at the hills, at our ""infantry""" \n
                         "	_barrage01 = [""BIS_mrkInfantry01"",""Sh_82mm_AMOS"",150,40,[5,6],nil,nil,nil,nil,[""mortar1"",""mortar2""]] spawn BIS_fnc_fireSupportVirtual;" \n
                         "	_barrage02 = [""BIS_mrkInfantry02"",""Sh_82mm_AMOS"",150,40,[5,6],nil,nil,nil,nil,[""mortar1"",""mortar2""]] spawn BIS_fnc_fireSupportVirtual;" \n
                         "	// Mortar barrage at the eastern line" \n
                         "	_barrageEast01 = [""BIS_mrkEast02"",""Sh_82mm_AMOS"",200,40,[5,6]] spawn BIS_fnc_fireSupportVirtual;" \n
                         "};" \n
