                /*%FSM</STATE>*/
                /*%FSM<STATE "set_new_tasks__1">*/
                class set_new_tasks__1
                {
                        name = "set_new_tasks__1";
                        itemno = 13;
                        init = /*%FSM<STATEINIT""">*/"//Show markers" \n
                         "{ _x setMarkerAlpha 1 } forEach [""Mrk_Task_1a"", ""Mrk_Task_1b""];" \n
                         "" \n
                         "//Player is the new actual" \n
                         "B_PlayerGroup selectLeader player;" \n
                         "" \n
                         "//Create Task 1a" \n
                         "private _description = format [" \n
                         "	""%1<br/>%2<br/>%3<br/><br/>%4""," \n
                         "	""Силы ЧСО ведут бои на обоих флангах от вашей <marker name='Mrk_TaskStart'>позиции</marker>.""," \n
                         "	""<marker name='Mrk_Task_1a'>Позиция к югу</marker> упростит наше продвижение вглубь острова по напралению к вражеской линии фронта.""," \n
                         "	""Поддержите бронетехнику при штурме и укрепитесь в деревне""," \n
                         "	""<font color='#ff0000'>Внимание: обнаружена тяжелая бронетехника противника!</font>""" \n
                         "];" \n
                         "[""taskAttack_1"", ""rifle""] call EP_fnc_missionTasks;" \n
                         "[""taskAttack_1"", true] call BIS_fnc_taskSetAlwaysVisible;" \n
                         "[" \n
                         "	player," \n
                         "	""taskAttack_1""," \n
                         "	[_description, ""Захватить Позицию""]," \n
                         "	markerPos ""Mrk_Task_1a""," \n
                         "	""CREATED""" \n
                         "] spawn BIS_fnc_taskCreate;" \n
                         "" \n
                         "//Create Task 1b" \n
                         "_description = format [" \n
                         "	""%1<br/>%2""," \n
                         "	""Силы ЧСО ведут бои на обоих флангах от вашей <marker name='Mrk_TaskStart'>позиции</marker>.""," \n
                         "	""Поддержите отряд Зеленый-6 и захватите <marker name='Mrk_Task_1b'>деревню</marker> для укрепления позиций.""" \n
                         "];" \n
                         "[""taskAttack_2"", ""rifle""] call EP_fnc_missionTasks;" \n
                         "[""taskAttack_2"", true] call BIS_fnc_taskSetAlwaysVisible;" \n
                         "[" \n
                         "	player," \n
                         "	""taskAttack_2""," \n
                         "	[_description, ""Захватить Позицию""]," \n
                         "	markerPos ""Mrk_Task_1b""," \n
                         "	""CREATED""" \n
                         "] spawn BIS_fnc_taskCreate;" \n
                         "" \n
                         "//Failed tasks counter" \n
                         "EP_FailedTasks = 0;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "near_task_1b">*/
                                class near_task_1b
                                {
                                        itemno = 15;
