                /*%FSM</STATE>*/
                /*%FSM<STATE "comms_1">*/
                class comms_1
                {
                        name = "comms_1";
                        itemno = 11;
                        init = /*%FSM<STATEINIT""">*/"[[ [""Сержант"", ""Твою мать, они уничтожили БТР!"", 5] ]] spawn EP_fnc_missionConversations;" \n
                         "_btrDown_1 = true;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "BTR_1_KIA">*/
                                class BTR_1_KIA
                                {
                                        itemno = 8;
                                        priority = 0.000000;
                                        to="comms_1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!_btrDown_1 && !canMove B_StartBtr_1"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
