*//*%FSM</HEAD>*/
class FSM
{
        fsmName = "Showcase Combined Arms Mission Flow";
        class States
        {
                /*%FSM<STATE "start_combat">*/
                class start_combat
                {
                        name = "start_combat";
                        itemno = 1;
                        init = /*%FSM<STATEINIT""">*/"deleteVehicle Trg_Start;" \n
                         "private _units = (getMissionLayerEntities ""StartAmb"" # 0) + (getMissionLayerEntities ""StartCombat"" # 0);" \n
                         "{ _x enableSimulation true } forEach _units;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "player_dismounte">*/
                                class player_dismounte
                                {
                                        itemno = 5;
                                        priority = 0.000000;
                                        to="start_advance";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"vehicle player == player"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "init">*/
                class init
                {
                        name = "init";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"//Nothing..." \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "cheat_1">*/
                                class cheat_1
                                {
                                        itemno = 18;
                                        priority = 1.000000;
                                        to="_";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"true"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "mission_started">*/
                                class mission_started
                                {
                                        itemno = 3;
                                        priority = 0.000000;
                                        to="Intro";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > 0"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Intro">*/
                class Intro
                {
                        name = "Intro";
                        itemno = 4;
                        init = /*%FSM<STATEINIT""">*/"enableRadio false;" \n
                         "enableSentences false;" \n
                         "" \n
                         "//Send truck" \n
                         "[B_PlayerGroup, ""Mrk_TaskStart"", ""GETOUT""] call EP_fnc_addWaypoint;" \n
                         "[B_PlayerGroup, ""B_WpStart"", ""MOVE"", ""COMBAT""] call EP_fnc_addWaypoint;" \n
                         "B_Truck lock true;" \n
                         "" \n
                         "//***************" \n
                         "//Intro" \n
                         "//***************" \n
                         "spawn {" \n
                         "	//Start at black screen" \n
                         "	[""Black"", false] call BIS_fnc_blackOut;" \n
                         "	//Fade in with blur" \n
                         "	sleep 5;" \n
                         "	[""Black"", false] call BIS_fnc_blackIn;" \n
                         "	private _handle = [1, ""BLACK"", 5, 1, ""CUP_A2_The_Movement""] spawn BIS_fnc_fadeEffect;" \n
                         "	waitUntil {scriptDone _handle};" \n
                         "	sleep 5;" \n
                         "	//Show SITREP" \n
                         "	[ " \n
                         "  		[ " \n
                         "   			[format [""Эверон, %1"", [dayTime, ""HH:MM""] call BIS_fnc_timeToString], ""<t align='left'>%1</t><br/>"", 10], " \n
                         "			[""ОБР ЧСО"", ""<t align='left'>%1</t><br/>"", 10]," \n
                         "   			[format [""Капитан %1"", name player], ""<t align='left'>%1</t><br/>"", 30]" \n
                         "  		], " \n
                         "  		safeZoneW + safeZoneX * 1.5, 1 " \n
                         " 	] spawn BIS_fnc_typeText;" \n
                         "};"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "player_near_dest">*/
                                class player_near_dest
                                {
                                        itemno = 0;
                                        priority = 0.000000;
                                        to="start_combat";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"triggerActivated Trg_Start"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "start_advance">*/
                class start_advance
                {
                        name = "start_advance";
                        itemno = 6;
                        init = /*%FSM<STATEINIT""">*/"enableRadio true;" \n
                         "enableSentences true;" \n
                         "" \n
                         "//Small cleanup" \n
                         "{ deleteVehicle _x } forEach (getMissionLayerEntities ""StartAmb"" # 0);" \n
                         "" \n
                         "private _westGroups = (getMissionLayerEntities ""StartCombat"" # 2) select { side _x == west };" \n
                         "private _eastUnits = flatten (((getMissionLayerEntities ""StartCombat"" # 2) select { side _x == east }) apply { units _x });" \n
                         "{" \n
                         "    _x call EP_fnc_clearWaypoints;" \n
                         "    [_x, ""B_WpStart"", 50] call EP_fnc_addWaypoint;" \n
                         "} forEach _westGroups;" \n
                         "" \n
                         "[[ [""Сержант"", ""Все - продвигаемся вперед! Оттесняем противника!"", 5] ]] spawn EP_fnc_missionConversations;" \n
                         "" \n
                         "//***************" \n
                         "//Flags" \n
                         "//***************" \n
                         "private _btrDown_1 = false;" \n
                         "private _btrDown_2 = false;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "BTR_1_KIA">*/
                                class BTR_1_KIA
                                {
                                        itemno = 8;
                                        priority = 0.000000;
                                        to="comms_1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!_btrDown_1 && !canMove B_StartBtr_1"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "BTR_2_KIA">*/
                                class BTR_2_KIA
                                {
                                        itemno = 9;
                                        priority = 0.000000;
                                        to="comms";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!_btrDown_2 && !canMove B_StartBtr_2"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "enemy_KIA">*/
                                class enemy_KIA
                                {
                                        itemno = 7;
                                        priority = 0.000000;
                                        to="comms_2";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_eastUnits findIf { alive _x } == -1"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "comms">*/
                class comms
                {
                        name = "comms";
                        itemno = 10;
                        init = /*%FSM<STATEINIT""">*/"[[ [""Сержант"", ""БТР подбит! Повторяю: Мы лишились техники!"", 5] ]] spawn EP_fnc_missionConversations;" \n
                         "_btrDown_2 = true;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "BTR_1_KIA">*/
                                class BTR_1_KIA
                                {
                                        itemno = 8;
                                        priority = 0.000000;
                                        to="comms_1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!_btrDown_1 && !canMove B_StartBtr_1"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "BTR_2_KIA">*/
                                class BTR_2_KIA
                                {
                                        itemno = 9;
                                        priority = 0.000000;
                                        to="comms";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!_btrDown_2 && !canMove B_StartBtr_2"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "enemy_KIA">*/
                                class enemy_KIA
                                {
                                        itemno = 7;
                                        priority = 0.000000;
                                        to="comms_2";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_eastUnits findIf { alive _x } == -1"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
