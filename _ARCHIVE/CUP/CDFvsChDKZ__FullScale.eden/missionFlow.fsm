                                        condition=/*%FSM<CONDITION""">*/"(player distance2D markerPos ""Mrk_Task_1b"") < 500"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "near_task_1a">*/
                                class near_task_1a
                                {
                                        itemno = 14;
                                        priority = 0.000000;
