                {
                        name = "Send_reinforceme";
                        itemno = 45;
                        init = /*%FSM<STATEINIT""">*/"[EP_Reinforcements] call EP_fnc_activateUnits;" \n
                         "" \n
                         "EP_ReinfDone = false;" \n
                         "EP_Reinforcements addWaypoint [markerPos ""wpConvoy_4"", -1];" \n
                         "EP_Reinforcements addWaypoint [markerPos ""wpConvoy_5"", -1];" \n
                         "private _wp = EP_Reinforcements addWaypoint [markerPos ""wpConvoy_6"", -1];" \n
                         "_wp setWaypointStatements [""true"", ""EP_ReinfDone = true""];" \n
                         "" \n
                         "//Unstuck check" \n
                         "spawn {" \n
                         "    private _apcs = ([EP_Reinforcements, true] call BIS_fnc_groupVehicles);" \n
                         "    while {!EP_ReinfDone} do {" \n
                         "        {" \n
                         "            if (vehicle _x != vehicle leader EP_Reinforcements && {unitReady driver _x && speed _x < 5 && vehicle _x != vehicle leader EP_Reinforcements}) then {" \n
                         "                driver _x doFollow leader EP_Reinforcements" \n
                         "            };" \n
                         "" \n
                         "            if (vehicle _x == vehicle leader EP_Reinforcements && {unitReady driver _x && speed _x < 5}) then {" \n
                         "                driver _x doMove waypointPosition ([EP_Reinforcements, currentWaypoint EP_Reinforcements]);" \n
                         "            };" \n
                         "        } forEach _apcs;" \n
                         "" \n
                         "			sleep 5;" \n
                         "    };" \n
                         "};"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
