class FSM
{
        fsmName = "Showcase Combined Arms Mission Flow";
        class States
        {
                /*%FSM<STATE "start">*/
                class start
                {
                        name = "start";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"//Tasks" \n
                         """EP_prepare"" call BIS_fnc_missionTasks;" \n
                         """EP_assault"" call BIS_fnc_missionTasks;" \n
                         "" \n
                         "execVM ""scripts\start.sqf"""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Dismounted">*/
                                class Dismounted
                                {
                                        itemno = 1;
                                        priority = 0.000000;
                                        to="Start_attack";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!isNil ""EP_InPosition"""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Start_attack">*/
                class Start_attack
                {
                        name = "Start_attack";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"execVM ""scripts\attackBase.sqf"";" \n
                         "" \n
                         "//True when Alpha is dead" \n
                         "EP_AlphaKIA = false;" \n
                         "//True when BMP is down" \n
                         "EP_BmpKIA = false;" \n
                         "//True when Bravo2 is in COMBAT" \n
                         "EP_Bravo2Combat = false;" \n
                         "//True when Alpha is near" \n
                         "EP_AlphaInPos = false;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Alpha_KIA">*/
                                class Alpha_KIA
                                {
                                        itemno = 5;
                                        priority = 0.000000;
                                        to="Comms";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!EP_AlphaKIA &&" \n
                                         "{units EP_Alpha findIf {alive _x} == -1}"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
