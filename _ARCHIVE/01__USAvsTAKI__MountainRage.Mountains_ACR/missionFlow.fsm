                                         "{!canMove EP_BMP}"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Bravo_2_In_Comba">*/
                                class Bravo_2_In_Comba
                                {
                                        itemno = 17;
                                        priority = 0.000000;
