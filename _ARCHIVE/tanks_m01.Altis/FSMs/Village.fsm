/*%FSM<COMPILE "C:\Program Files (x86)\Steam\steamapps\common\Arma 3 Tools\FSMEditor\scriptedFSM.cfg, Village">*/
/*%FSM<HEAD>*/
/*
item0[] = {"Start",0,250,-75.000000,-450.000000,25.000000,-400.000000,0.000000,"Start"};
item1[] = {"Timeout_160sec",4,218,50.000000,-300.000000,150.000000,-250.000000,0.000000,"Timeout" \n "160sec"};
item2[] = {"Another_Wiesel_a",2,250,50.000000,-225.000000,150.000000,-175.000000,0.000000,"Another" \n "Wiesel" \n "available"};
item3[] = {"FIA_defeated",4,218,-75.000000,-75.000000,25.000000,-25.000000,0.000000,"FIA" \n "defeated"};
item4[] = {"Task_DONE",1,250,-75.000000,0.000000,25.000000,50.000000,0.000000,"Task" \n "DONE"};
item5[] = {"FIA_in_Ifestiona",2,250,-75.000000,-300.000000,25.000000,-250.000000,0.000000,"FIA in" \n "Ifestiona"};
item6[] = {"Timeout_40sec",4,218,-75.000000,-375.000000,25.000000,-325.000000,0.000000,"Timeout" \n "40sec"};
item7[] = {"FIA_losses",4,218,-75.000000,-225.000000,25.000000,-175.000000,0.000000,"FIA" \n "losses"};
item8[] = {"FIA_retreat",2,250,-75.000000,-150.000000,25.000000,-100.000000,0.000000,"FIA retreat"};
link0[] = {0,6};
