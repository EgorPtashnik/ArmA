                /*%FSM<STATE "Report_1">*/
                class Report_1
                {
                        name = "Report_1";
                        itemno = 10;
                        init = /*%FSM<STATEINIT""">*/"_report = [] spawn {" \n
                         "	""Forest_HunterKilled"" call BIS_fnc_missionConversations;" \n
                         "	""Forest_ReportHunterDead"" call BIS_fnc_missionConversations;" \n
                         "	""Forest_ReportOut"" call BIS_fnc_missionConversations;" \n
                         "" \n
                         "	_null = execVM ""ForestReinforcements.sqf"";" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Finished">*/
                                class Finished
                                {
                                        itemno = 13;
                                        priority = 0.000000;
                                        to="Scene";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"scriptDone _report" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Scene">*/
                class Scene
                {
                        name = "Scene";
                        itemno = 12;
                        init = /*%FSM<STATEINIT""">*/"[] spawn {" \n
                         "/*" \n
                         "	// DELETE DELAY AFTER VOICE ACTING IS RECORDED" \n
                         "	sleep 5;" \n
                         "" \n
                         "	// Black out" \n
                         "	cutText ["""",""Black out"",2];" \n
                         "	2 fadeSound 0;" \n
                         "	clearRadio;" \n
                         "	enableRadio false;" \n
                         "" \n
                         "	sleep 2.5;" \n
                         "	// Stop player" \n
                         "	BIS_ARPlayer enableSimulation false;" \n
                         "" \n
                         "	// Skip time" \n
                         "	skipTime 0.5;" \n
                         "" \n
                         "	// Delete the M14" \n
                         "	deleteVehicle BIS_Mk14;" \n
                         "" \n
                         "	// Music" \n
                         "	0 fadeMusic 0;" \n
                         "	playMusic [""AmbientTrack02_F_Orange"",25];" \n
                         "	5 fadeMusic 1;" \n
                         "" \n
                         "	sleep 0.5;" \n
                         "	// Hunter - dead or alive consequences" \n
                         "	if ((damage BIS_ARHunter > 0) and (damage BIS_ARHunter < 1)) then {" \n
                         "		BIS_Medikit setPos (getPosATL BIS_MedikitPos);" \n
                         "		BIS_Blood setPos (getPosATL BIS_BloodPos);" \n
                         "	};" \n
                         "	if (alive BIS_ARHunter) then {" \n
                         "		{deleteVehicle _x} forEach [BIS_Pandur,BIS_Bodybag];" \n
                         "		BIS_ARHunter allowDamage false;" \n
                         "		BIS_ARHunter setPosATL [14223.4,21208.8,12.7593];" \n
                         "		BIS_ARHunter setBehaviour ""Careless"";" \n
                         "	} else {" \n
                         "		deleteVehicle BIS_ARHunter;" \n
                         "		deleteVehicle BIS_Medikit;" \n
                         "		BIS_Bodybag setPos (getPosATL BIS_BodybagPos);" \n
                         "		BIS_Pandur setPos (getPosATL BIS_PandurPos);" \n
                         "	};" \n
                         "" \n
                         "	// Player" \n
                         "	BIS_ARPlayer setPos (getPosATL BIS_PlayerPos);" \n
                         "	BIS_ARPlayer setDir 70;" \n
                         "	if (currentWeapon BIS_ARPlayer == primaryWeapon BIS_ARPlayer) then {BIS_ARPlayer switchMove ""amovpercmstpslowwrfldnon""};" \n
                         "	if (currentWeapon BIS_ARPlayer == handgunWeapon BIS_ARPlayer) then {BIS_ARPlayer switchMove ""amovpercmstpslowwpstdnon""};" \n
                         "	if (currentWeapon BIS_ARPlayer in ["""",""Binocular"",""Rangefinder""]) then {BIS_ARPlayer switchMove ""amovpercmstpsnonwnondnon""};" \n
                         "" \n
                         "	// Wiesel" \n
                         "	BIS_Wiesel allowDamage false;" \n
                         "	BIS_Wiesel setDir 250;" \n
                         "	BIS_Wiesel setPos (getPosATL BIS_WieselPos);" \n
                         "	BIS_Wiesel setVectorUp [0,0,1]; // Just in case it got flipped somewhere" \n
                         "	BIS_Wiesel allowDamage true;" \n
                         "" \n
                         "	// Driver" \n
                         "	if ((alive BIS_ARDriver) and (vehicle BIS_ARDriver != BIS_Wiesel)) then {BIS_Driver setPos (getPosATL BIS_DriverPos)};" \n
                         "" \n
                         "	// Investigators" \n
                         "	BIS_Unit01 setPos (getPosATL BIS_Unit01Pos);" \n
                         "	BIS_Unit02 setPos (getPosATL BIS_Unit02Pos);" \n
                         "	BIS_Unit03 setPos (getPosATL BIS_Unit03Pos);" \n
                         "	BIS_Unit04 setPos (getPosATL BIS_Unit04Pos);" \n
                         "" \n
                         "	[BIS_Unit01,""WATCH1"",""ASIS""] call BIS_fnc_ambientAnim;" \n
                         "	[BIS_Unit02,""WATCH2"",""ASIS""] call BIS_fnc_ambientAnim;" \n
                         "	[BIS_Unit03,""WATCH1"",""ASIS""] call BIS_fnc_ambientAnim;" \n
                         "	[BIS_Unit04,""WATCH2"",""ASIS""] call BIS_fnc_ambientAnim;" \n
                         "" \n
                         "	{BIS_ARPlayer reveal [_x,4]} forEach [BIS_Unit01,BIS_Unit02,BIS_Unit03,BIS_Unit04];" \n
                         "" \n
                         "	sleep 8;" \n
                         "	// 30 minutes later" \n
                         "	_null = [localize ""str_a3_a_out_some_time_later"", 0, 0.95, 5, 0.5] spawn BIS_fnc_dynamicText;" \n
                         "" \n
                         "	sleep 8;" \n
                         "" \n
                         "	// Black in" \n
                         "	cutText ["""",""Black in"",5];" \n
                         "	5 fadeSound 0.5;" \n
                         "	enableRadio true;" \n
                         "	BIS_ARPlayer enableSimulation true;" \n
                         "	5 fadeMusic 0.5;" \n
                         "" \n
                         "	sleep 5;" \n
                         "*/" \n
                         "	// Tasks" \n
                         "	[""BIS_tskForest"",""Succeeded""] call BIS_fnc_missionTasks;" \n
                         "	[""BIS_tskCheckpointB"",""Current""] call BIS_fnc_missionTasks;" \n
                         "	{BIS_ARPlayer reveal [_x,4]} forEach [BIS_Unit01,BIS_Unit02,BIS_Unit03,BIS_Unit04];" \n
                         "" \n
                         "	sleep 10;" \n
                         "	saveGame;" \n
                         "};" \n
                         "" \n
                         """BIS_mrkFIAFlag"" setMarkerAlpha 0;" \n
                         "{_x setMarkerColor ""ColorGrey""} forEach [" \n
                         "	""BIS_mrkForest_01""," \n
                         "	""BIS_mrkForest_02""," \n
                         "	""BIS_mrkForest_03""," \n
                         "	""BIS_mrkForest_04""," \n
                         "	""BIS_mrkForest_05""," \n
                         "	""BIS_mrkForest_06""," \n
                         "	""BIS_mrkForestArea""" \n
                         "];" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Leaving_the_area">*/
                                class Leaving_the_area
                                {
                                        itemno = 17;
                                        priority = 0.000000;
                                        to="Conversation";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(vehicle BIS_ARPlayer) distance2D BIS_Cottage > 150" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Report_2">*/
                class Report_2
                {
                        name = "Report_2";
                        itemno = 15;
                        init = /*%FSM<STATEINIT""">*/"""Forest_Close"" spawn BIS_fnc_missionConversations;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Dead_or___">*/
                                class Dead_or___
                                {
                                        itemno = 6;
                                        priority = 5.000000;
                                        to="Report_1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(alive BIS_ARHunter)" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Close_by_civilia">*/
                                class Close_by_civilia
                                {
                                        itemno = 1;
                                        priority = 0.000000;
                                        to="Freeze_";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"((vehicle BIS_ARPlayer) distance2D BIS_ARHunter < 10) and" \n
                                         "{(vehicle BIS_ARPlayer == BIS_ARPlayer)} and" \n
                                         "{(getPosATL BIS_ARPlayer select 2) > 0.1} and" \n
                                         "{(alive BIS_ARHunter)}" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Conversation">*/
                class Conversation
                {
                        name = "Conversation";
                        itemno = 18;
                        init = /*%FSM<STATEINIT""">*/"// The topic is actually different, but I kept the class name" \n
                         "// - it was about AAF propaganda, lies, half-truths etc." \n
                         "" \n
                         """Lies"" spawn BIS_fnc_missionConversations;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Comms_with_drive">*/
                class Comms_with_drive
                {
                        name = "Comms_with_drive";
                        itemno = 20;
                        init = /*%FSM<STATEINIT""">*/"[] spawn {" \n
                         "	playMusic ""AmbientTrack01_F_EPB"";" \n
                         "	""KeepYourEyesOpened"" call BIS_fnc_missionConversations;" \n
                         "	_null = [[""Weapons"", ""SlatArmor""], 30] spawn BIS_fnc_advHint;" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
