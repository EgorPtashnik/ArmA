class FSM
{
        fsmName = "Forest";
        class States
        {
                /*%FSM<STATE "Start">*/
                class Start
                {
                        name = "Start";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"// Move Hunter to his cabin and unhide the Rifle, unlock and open doors" \n
                         "" \n
                         "BIS_Cottage setVariable [""bis_disabled_Door_1"",0];" \n
                         "BIS_Cottage animate [""Door_1_rot"",1];" \n
                         "BIS_Mk14 hideObject false;" \n
                         "" \n
                         "BIS_ARHunter hideObject false;" \n
                         "BIS_ARHunter enableSimulation true;" \n
                         "BIS_ARHunter allowDamage true;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Dead_or___">*/
                                class Dead_or___
                                {
                                        itemno = 6;
                                        priority = 5.000000;
                                        to="Report_1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(alive BIS_ARHunter)" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Near_forest">*/
                                class Near_forest
                                {
                                        itemno = 19;
                                        priority = 0.000000;
                                        to="Comms_with_drive";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"((vehicle BIS_ARPlayer) distance2D BIS_ARHunter < 850)" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Freeze_">*/
                class Freeze_
                {
                        name = "Freeze_";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"_t = time;" \n
                         "BIS_ARHunter playMove ""ApanPknlMstpSnonWnonDnon_G01"";" \n
                         """Forest_HunterFound"" spawn BIS_fnc_missionConversations;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
