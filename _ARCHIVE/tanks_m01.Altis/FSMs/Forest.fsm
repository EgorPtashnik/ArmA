                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Report">*/
                class Report
                {
                        name = "Report";
                        itemno = 9;
                        init = /*%FSM<STATEINIT""">*/"_report = [] spawn {" \n
                         "	""Forest_ReportHunterAlive"" call BIS_fnc_missionConversations;" \n
                         "	""Forest_ReportOut"" call BIS_fnc_missionConversations;" \n
                         "" \n
                         "	_null = execVM ""ForestReinforcements.sqf"";" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
