                                         "{{(vehicle BIS_ARPlayer) knowsAbout _x > 0.5} forEach (units _x)} count BIS_FIAgroups > 0" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
