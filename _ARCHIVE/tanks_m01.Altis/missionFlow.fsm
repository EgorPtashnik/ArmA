                         "	[""Fail01"",false,true,true,true] call BIS_fnc_endMission;" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "FAIL_02">*/
                class FAIL_02
                {
                        name = "FAIL_02";
                        itemno = 12;
                        init = /*%FSM<STATEINIT""">*/"[] spawn {" \n
                         "	sleep 5;" \n
                         "	""FUBAR"" call BIS_fnc_missionConversations;" \n
                         "	sleep 7.5;" \n
                         "	[""Fail02"",false,true,true,true] call BIS_fnc_endMission;" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "WIN">*/
                class WIN
                {
                        name = "WIN";
                        itemno = 13;
                        init = /*%FSM<STATEINIT""">*/"[] spawn {" \n
                         "	sleep 5;" \n
                         "	if (BIS_CollateralDamage < BIS_CollateralDamageFailLimit) then {" \n
                         "		profileNamespace setVariable [""BIS_Tanks_LimitedDamage"",1];" \n
                         "		[""Win01"",true,true,true,true] call BIS_fnc_endMission;" \n
                         "	} else {" \n
                         "		profileNamespace setVariable [""BIS_Tanks_LimitedDamage"",0];" \n
                         "		[""Win02"",true,true,true,true] call BIS_fnc_endMission;" \n
                         "	};" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "FIA_in_village">*/
                class FIA_in_village
                {
                        name = "FIA_in_village";
                        itemno = 15;
                        init = /*%FSM<STATEINIT""">*/"execFSM ""FSMs\Village.fsm"";" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Disobeying_order">*/
                                class Disobeying_order
                                {
                                        itemno = 5;
                                        priority = 0.000000;
                                        to="FAIL_01";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"BIS_Fail" \n
