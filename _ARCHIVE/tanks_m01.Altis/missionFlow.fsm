                /*%FSM<STATE "Opening__exec_all">*/
                class Opening__exec_all
                {
                        name = "Opening__exec_all";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"0 fadeMusic 0.75;" \n
                         "playMusic ""LeadTrack01_F_EPA"";" \n
                         "" \n
                         "execFSM ""FSMs\Wiesel.fsm"";" \n
                         "execFSM ""FSMs\Equipment.fsm"";" \n
                         "/*" \n
                         "execFSM ""FSMs\CheckpointA.fsm"";" \n
                         "execFSM ""FSMs\CheckpointB.fsm"";" \n
                         "execFSM ""FSMs\CollateralDamage.fsm"";" \n
                         "execFSM ""FSMs\Maintenance.fsm"";" \n
                         "execFSM ""FSMs\Village.fsm"";" \n
                         "execFSM ""FSMs\AO.fsm"";" \n
                         "execFSM ""FSMs\Conversations.fsm"";" \n
                         "*/" \n
                         "" \n
                         "// Initial conversations" \n
                         "[] spawn {" \n
                         "	""Prologue"" call BIS_fnc_missionConversations;" \n
                         "	sleep 5;" \n
                         "	""HQ_Announcement"" call BIS_fnc_missionConversations;" \n
                         "};" \n
                         "" \n
                         "// Hide the FIA units in Ifestiona" \n
                         "{_x hideObject true; _x enableSimulation false} forEach BIS_FIAUnits + BIS_CIVUnits;" \n
                         "{_x hideObject true; _x enableSimulation false} forEach [BIS_Offroad_MG,BIS_Offroad_AT,BIS_Car04,BIS_Car05,BIS_Car06];" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Disobeying_order">*/
                                class Disobeying_order
                                {
                                        itemno = 5;
                                        priority = 0.000000;
                                        to="FAIL_01";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"BIS_Fail" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Wiesel_KO">*/
                                class Wiesel_KO
                                {
                                        itemno = 6;
                                        priority = 0.000000;
                                        to="FAIL_02";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(damage BIS_Wiesel == 1) and" \n
                                         "{(alive BIS_ARPlayer)}" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Original_tasks_d">*/
                                class Original_tasks_d
                                {
                                        itemno = 14;
                                        priority = 0.000000;
                                        to="FIA_in_village";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"/*" \n
                                         "({_x call BIS_fnc_taskState == ""Succeeded""} count [" \n
                                         "	""BIS_tskCheckpointA""," \n
                                         "	""BIS_tskForest""" \n
                                         "] == 2)" \n
                                         "and" \n
                                         "(""BIS_tskCheckpointB"" call BIS_fnc_taskState == ""Canceled"")" \n
                                         "*/" \n
                                         "" \n
                                         "(""BIS_tskCheckpointA"" call BIS_fnc_taskState == ""Succeeded"") and" \n
                                         "{(""BIS_tskCheckpointB"" call BIS_fnc_taskState == ""Canceled"")} and" \n
                                         "{""BIS_tskForest"" call BIS_fnc_taskState == ""Succeeded""}" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "FAIL_FF">*/
                class FAIL_FF
                {
                        name = "FAIL_FF";
                        itemno = 10;
                        init = /*%FSM<STATEINIT""">*/"[] spawn {" \n
                         "	BIS_ARPlayer addRating (abs (rating BIS_ARPlayer));" \n
                         "	sleep 5;" \n
                         "	[""FriendlyFire"",false,true,true,true] call BIS_fnc_endMission;" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
