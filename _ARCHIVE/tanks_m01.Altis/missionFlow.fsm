                                        condition=/*%FSM<CONDITION""">*/"(damage BIS_Wiesel == 1) and" \n
                                         "{(alive BIS_ARPlayer)}" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "All_tasks_DONE">*/
                                class All_tasks_DONE
                                {
                                        itemno = 3;
                                        priority = 0.000000;
                                        to="WIN";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"// ""BIS_tskAttack"" call BIS_fnc_taskState == ""Succeeded""" \n
                                         "BIS_End" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "TERMINATE">*/
                class TERMINATE
                {
                        name = "TERMINATE";
                        itemno = 18;
                        init = /*%FSM<STATEINIT""">*/"[] spawn {" \n
                         "	waitUntil {time > 0};" \n
                         "	enableEnvironment [false, false];" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Variables__FSMs">*/
                class Variables__FSMs
                {
                        name = "Variables__FSMs";
                        itemno = 20;
                        init = /*%FSM<STATEINIT""">*/"_t = time;" \n
                         "" \n
                         "// Variable used in major tasks' fsms - if these fail, mission will fail as well" \n
                         "BIS_Fail = false;" \n
                         "" \n
                         "// End mission var" \n
                         "BIS_End = false;" \n
                         "" \n
                         "// Variable used in AO.fsm - if triggered, fail the mission with desertion ending" \n
                         "BIS_Desertion = false;" \n
                         "" \n
                         "// Check if AAF was detected nearby village" \n
                         "BIS_Detected = false;" \n
                         "" \n
                         "// Disable rabbits and snakes" \n
                         "[] spawn {" \n
                         "	waitUntil {time > 0};" \n
                         "	enableEnvironment [false, true];" \n
                         "};" \n
                         "" \n
                         "// Make sure player has a backpack for Toolkit" \n
                         "[] spawn {" \n
                         "	waitUntil {time > 0};" \n
                         "	if (backpack BIS_ARPlayer == """") then {BIS_ARPlayer addBackpack ""B_Fieldpack_oli""};" \n
                         "	if !(""ItemRadio"" in items BIS_ARPlayer) then {BIS_ARPlayer linkItem ""ItemRadio""};" \n
                         "	BIS_ARPlayer switchMove ""amovpercmstpslowwrfldnon"";" \n
                         "};" \n
                         "" \n
                         "// Conversations - yell when injured" \n
                         "BIS_Hit = false;" \n
                         "[] spawn {" \n
                         "	waitUntil {sleep 1; BIS_Hit};" \n
                         "	""Injured"" call BIS_fnc_missionConversations;" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
