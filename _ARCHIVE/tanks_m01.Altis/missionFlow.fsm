                                        condition=/*%FSM<CONDITION""">*/"side BIS_ARPlayer == sideEnemy" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
