briefingName	= "The Devil's Offensive";
author			= "Axle";
overviewText 	= "The year is 2035. NATO has started their offensive on The Republic of Altis and Stratis. A special forces team named Basilisk is ordered to cause a distraction to stop the 29th MEU from advancing further inland.";
overviewPicture = "images\loading.jpg";
onLoadName		= "The Devil's Offensive";
onLoadMission	= "AAF special forces move to disrupt the United States from advancing further into Altis.";
loadScreen		= "images\loading.jpg";

class CfgDebriefing
{
	class endwin1
	{
		title = "Mission Completed";
		subtitle = "";
		description = "Basilisk team was able to slow down their advance tonight! Solid Work! Hopefully CSAT keeps their end of the deal. Now take a breather before getting out of there and returning to friendly lines. The Americans will surely be looking for you.";
		pictureBackground = "images\endwin1.jpg";
		pictureColor[] = { 0.0, 0.3, 0.6, 1 };
	};
	class endfail1
	{
		title = "Mission Failed";
		subtitle = "";
		description = "The AAF defenses at the airport were destroyed.";
		pictureBackground = "images\endfail1.jpg";
		pictureColor[] = { 0.0, 0.3, 0.6, 1 };
	};
	class endfail2
	{
		title = "Mission Failed";
		subtitle = "";
		description = "Dumb fuck.";
		pictureBackground = "images\endfail2.jpg";
		pictureColor[] = { 0.0, 0.3, 0.6, 1 };
	};
};

