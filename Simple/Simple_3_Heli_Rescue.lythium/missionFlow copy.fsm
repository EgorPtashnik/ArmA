item7[] = {"prepare_heli_crash",2,250,-75.000000,-1225.000000,25.000000,-1175.000000,0.000000,"prepare heli crash" \n "site"};
item8[] = {"preparations_don",4,218,-75.000000,-1125.000000,25.000000,-1075.000000,0.000000,"preparations" \n "done"};
