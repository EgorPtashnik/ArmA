*//*%FSM</HEAD>*/
class FSM
{
        fsmName = "missionFlow";
        class States
        {
                /*%FSM<STATE "start">*/
                class start
                {
                        name = "start";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"private [""_time"", ""_thread""];"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "mission_started">*/
                                class mission_started
                                {
                                        itemno = 1;
                                        priority = 0.000000;
                                        to="insertion";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(isNil ""EP_MISSION_STARTED"")"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "insertion">*/
                class insertion
                {
                        name = "insertion";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"_time = time + 30;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "timeout_30">*/
                                class timeout_30
                                {
                                        itemno = 3;
                                        priority = 0.000000;
                                        to="comms_check";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > _time"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "TODO">*/
                class TODO
                {
                        name = "TODO";
                        itemno = 4;
                        init = /*%FSM<STATEINIT""">*/""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "comms_check">*/
                class comms_check
                {
                        name = "comms_check";
                        itemno = 5;
                        init = /*%FSM<STATEINIT""">*/"_thread = ""START_REPORT"" spawn BIS_fnc_missionConversations;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "heli_crash_start">*/
                                class heli_crash_start
                                {
                                        itemno = 6;
                                        priority = 0.000000;
                                        to="prepare_heli_crash";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(isNil ""EP_HELI_CRASH_START"")"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "prepare_heli_crash">*/
                class prepare_heli_crash
                {
                        name = "prepare_heli_crash";
                        itemno = 7;
                        init = /*%FSM<STATEINIT""">*/"private [""_crashVariants""];" \n
                         "_crashVariants = [""1"", ""2"", ""3""];" \n
                         "" \n
                         "EP_HELI_CRASH_VARIANT = selectRandom [""1"", ""2"", ""3""];" \n
                         "" \n
                         "// Create HashMap with all needed heli crash variables" \n
                         "EP_CRASH_MAP = createHashMap;" \n
                         "EP_CRASH_MAP set [""MARKER"", (""EP_MARKER_HELI_CRASH_"" + EP_HELI_CRASH_VARIANT)];" \n
                         "EP_CRASH_MAP set [""WRECK"", (missionNamespace getVariable (""EP_HELI_WRECK_"" + EP_HELI_CRASH_VARIANT))];" \n
                         "EP_CRASH_MAP set [""SPAWN"", [getMarkerPos ""EP_MARKER_SPAWN_"" + EP_HELI_CRASH_VARIANT + ""_1"", getMarkerPos ""EP_MARKER_SPAWN_"" + EP_HELI_CRASH_VARIANT + ""_2""]];" \n
                         "" \n
                         "(EP_CRASH_MAP get ""MARKER"") setMarkerAlpha 1;" \n
                         "" \n
                         "//Cleanup" \n
                         "{" \n
                         "	if (_x != EP_HELI_CRASH_VARIANT) then {" \n
                         "		{" \n
                         "			deleteVehicle _x;" \n
                         "		} forEach getMissionLayerEntities (""Layer_Heli_Crash_Site_"" + _x) # 0;" \n
                         "		deleteVehicle ( ((missionNamespace getVariable ( ""EP_MODULE_SMOKE_"" + _x )) getVariable ""effectEmitter"") select 0);" \n
                         "	};" \n
                         "} forEach _crashVariants;" \n
                         "" \n
                         "_thread = _crashVariants spawn {" \n
                         "	sleep 1;" \n
                         "	{" \n
                         "		if (_x != EP_HELI_CRASH_VARIANT) then {" \n
                         "			deleteVehicle ( ((missionNamespace getVariable ( ""EP_MODULE_SMOKE_"" + _x )) getVariable ""effectEmitter"") select 0 );" \n
                         "			deleteVehicle (missionNamespace getVariable (""EP_PILOT_"" + _x + ""_1""));" \n
                         "			deleteVehicle (missionNamespace getVariable (""EP_PILOT_"" + _x + ""_2""));" \n
                         "		};" \n
                         "	} forEach _this;" \n
                         "};" \n
                         "" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "preparations_don">*/
                                class preparations_don
                                {
                                        itemno = 8;
                                        priority = 0.000000;
                                        to="report_heli_crash";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"scriptDone _thread"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "report_heli_crash">*/
                class report_heli_crash
                {
                        name = "report_heli_crash";
                        itemno = 9;
                        init = /*%FSM<STATEINIT""">*/"_thread = [] spawn {" \n
                         "	EP_LITTLE_BIRD enableSimulation true;" \n
                         "	EP_LITTLE_BIRD lock false;" \n
                         "" \n
                         "	""REPORT_HELI_CRASH"" call BIS_fnc_missionConversations;" \n
                         "	""PATROL"" call BIS_fnc_missionTasks;" \n
                         "" \n
                         "	//Pilot" \n
                         "	group EP_PILOT_RESCUE addVehicle EP_LITTLE_BIRD;" \n
                         "	EP_PILOT_RESCUE assignAsDriver EP_LITTLE_BIRD;" \n
                         "	[EP_PILOT_RESCUE] orderGetIn true;" \n
                         "	[] spawn { waitUntil {EP_PILOT_RESCUE in EP_LITTLE_BIRD}; EP_LITTLE_BIRD engineOn true;};" \n
                         "" \n
                         "	//Rescue group" \n
                         "	EP_GROUP_RESCUE addVehicle EP_LITTLE_BIRD;" \n
                         "	{_x assignAsCargo EP_LITTLE_BIRD} forEach units EP_GROUP_RESCUE;" \n
                         "	EP_PLAYER assignAsCargo EP_LITTLE_BIRD;" \n
                         "	(units EP_GROUP_RESCUE) orderGetIn true;" \n
                         "" \n
                         "	""GET_IN_HELI"" call BIS_fnc_missionTasks;" \n
                         "}"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "in_heli">*/
                                class in_heli
                                {
                                        itemno = 10;
                                        priority = 0.000000;
                                        to="join___move_Little";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"scriptDone _thread && EP_PLAYER in EP_LITTLE_BIRD"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "join___move_Little">*/
                class join___move_Little
                {
                        name = "join___move_Little";
                        itemno = 11;
                        init = /*%FSM<STATEINIT""">*/"""GET_IN_HELI"" call BIS_fnc_missionTasks;" \n
                         "[EP_PLAYER] joinSilent EP_GROUP_RESCUE;" \n
                         "" \n
                         "[] spawn {" \n
                         "	waitUntil { {!(_x in EP_LITTLE_BIRD)} count units EP_GROUP_RESCUE == 0 };" \n
                         "" \n
                         "	//setup Little Bird" \n
                         "	private [""_group"", ""_wp"", ""_pos"", ""_heliPad""];" \n
                         "	_group = group EP_PILOT_RESCUE;" \n
                         "	EP_LITTLE_BIRD lock true;" \n
                         "	EP_LITTLE_BIRD flyInHeight 30;" \n
                         "" \n
                         "	_pos = [getPos (EP_CRASH_MAP get ""WRECK""), 500, 500, 20] call BIS_fnc_findSafePos;" \n
                         "	_wp  = _group addWaypoint [_pos, 0];" \n
                         "	_wp setWaypointType ""MOVE"";" \n
                         "" \n
                         "	_pos = [getPos (EP_CRASH_MAP get ""WRECK""), 100, 250, 20] call BIS_fnc_findSafePos;" \n
                         "	_heliPad = ""HeliHEmpty"" createVehicle _pos;" \n
                         "	_wp = _group addWaypoint [_pos, 0];" \n
                         "	_wp setWaypointType ""SCIPTED"";" \n
                         "	_wp setWaypointScript ""A3\functions_f\waypoints\fn_wpLand.sqf"";" \n
                         "" \n
                         "	sleep 10;" \n
                         "" \n
                         "	""IN_HELI"" spawn BIS_fnc_missionConversations;" \n
                         "" \n
                         "	waitUntil {sleep 1; !(isTouchingGround EP_LITTLE_BIRD)};" \n
                         "" \n
                         "	sleep 30;" \n
                         "	savegame;" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "landed">*/
                                class landed
                                {
                                        itemno = 12;
                                        priority = 0.000000;
                                        to="check_heli_crash";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"scriptDone _thread && isTouchingGround EP_LITTLE_BIRD"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "check_heli_crash">*/
                class check_heli_crash
                {
                        name = "check_heli_crash";
                        itemno = 13;
                        init = /*%FSM<STATEINIT""">*/"EP_GROUP_RESCUE leaveVehicle EP_LITTLE_BIRD;" \n
                         "_thread = ""DISMOUNTED"" spawn BIS_fnc_missionConversations;" \n
                         "EP_GROUP_RESCUE move (getPos (EP_CRASH_MAP get ""WRECK""));" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "dismounted">*/
                                class dismounted
                                {
                                        itemno = 14;
                                        priority = 0.000000;
                                        to="savegame";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"scriptDone _thread && ({_x in EP_LITTLE_BIRD} count units EP_GROUP_RESCUE) == 0"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "savegame">*/
                class savegame
                {
                        name = "savegame";
                        itemno = 15;
                        init = /*%FSM<STATEINIT""">*/"savegame;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "near_heli">*/
                                class near_heli
                                {
                                        itemno = 16;
                                        priority = 0.000000;
                                        to="Spawn_enemy";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(leader EP_GROUP_RESCUE) distance2D (getPos (EP_CRASH_MAP get ""WRECK"")) < 30"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Spawn_enemy">*/
                class Spawn_enemy
                {
                        name = "Spawn_enemy";
                        itemno = 17;
                        init = /*%FSM<STATEINIT""">*/""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
        };
        initState="start";
        finalStates[] =
        {
        };
};
/*%FSM</COMPILE>*/