*//*%FSM</HEAD>*/
class FSM
{
        fsmName = "missionFlow";
        class States
        {
                /*%FSM<STATE "START">*/
                class START
                {
                        name = "START";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"private [""_time"", ""_thread"", ""_colorEAST""];" \n
                         "" \n
                         "_colorEAST = east call BIS_fnc_sideColor;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "mission_started">*/
                                class mission_started
                                {
                                        itemno = 1;
                                        priority = 0.000000;
                                        to="Atack_AA_Post";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(isNil ""BIS_missionStarted"")"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Atack_AA_Post">*/
                class Atack_AA_Post
                {
                        name = "Atack_AA_Post";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"enableRadio true;" \n
                         "" \n
                         """START"" spawn BIS_fnc_missionConversations;" \n
                         "" \n
                         "group EP_Player addWaypoint [getMarkerPos ""MARKER_AA_POST"", 0];" \n
                         "private _defendersGroups = (getMissionLayerEntities ""Layer_1_Units"" # 2);" \n
                         "" \n
                         "playMusic ""CUP_A1_Arma_Magna"";" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "AA_Post_Captured">*/
                                class AA_Post_Captured
                                {
                                        itemno = 3;
                                        priority = 0.000000;
                                        to="Send_Reinforceme";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"{alive _x} count (units g_AA_Post_1 + units g_AA_Post_2) == 0"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Contact">*/
                                class Contact
                                {
                                        itemno = 21;
                                        priority = 0.000000;
                                        to="Defenders_Action";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"{combatBehaviour _x == ""COMBAT""} count _defendersGroups > 0"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Send_Reinforceme">*/
                class Send_Reinforceme
                {
                        name = "Send_Reinforceme";
                        itemno = 4;
                        init = /*%FSM<STATEINIT""">*/"[] spawn {" \n
                         "	sleep 4;" \n
                         "	""MARKER_AA_POST"" setMarkerColor ""ColorEAST"";" \n
                         "	""AA_POST"" call BIS_fnc_missionTasks;" \n
                         "	sleep 3;" \n
                         "	""AA_POST_CAPTURED"" call BIS_fnc_missionConversations;" \n
                         "	sleep 2;" \n
                         "	(getMissionLayerEntities ""Layer_Reinforcements"" # 0) call EP_fnc_showUnits;" \n
                         "	""WAIT_REINFORCEMENTS"" spawn BIS_fnc_missionTasks;" \n
                         "" \n
                         "	// Reinforcements wps" \n
                         "	private [""_wp"", ""_grp"", ""_pos""];" \n
                         "	_grp = group o_Heli_1;" \n
                         "	_pos = getPos o_Heli_1;" \n
                         "	_wp = _grp addWaypoint [getMarkerPos ""MARKER_AA_POST"", 0];" \n
                         "	_wp setWaypointType ""TR UNLOAD"";" \n
                         "	_wp = _grp addWaypoint [getPos o_Heli_1, 0];" \n
                         "" \n
                         "	_grp = group o_Heli_2;" \n
                         "	_wp = _grp addWaypoint [getMarkerPos ""wpUnhook_1"", 0];" \n
                         "	_wp setWaypointType ""UNHOOK"";" \n
                         "	_wp = _grp addWaypoint [getPos o_Heli_2, 0];" \n
                         "" \n
                         "	_grp = group o_Heli_3;" \n
                         "	_wp = _grp addWaypoint [getMarkerPos ""wpUnhook_2"", 0];" \n
                         "	_wp setWaypointType ""UNHOOK"";" \n
                         "	_wp = _grp addWaypoint [getPos o_Heli_3, 0];" \n
                         "" \n
                         "	sleep 10;" \n
                         "	playMusic ""BackgroundTrack04_F_EPC"";" \n
                         "}"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Arrived">*/
                                class Arrived
                                {
                                        itemno = 5;
                                        priority = 0.000000;
                                        to="Start_Attack";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"isTouchingGround o_BMP &&" \n
                                         "isTouchingGround o_BTR &&" \n
                                         "{_x in o_Heli_1} count units g_Reinf_Infantry == 0"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Start_Attack">*/
                class Start_Attack
                {
                        name = "Start_Attack";
                        itemno = 6;
                        init = /*%FSM<STATEINIT""">*/"[] spawn {" \n
                         "	""WAIT_REINFORCEMENTS"" call BIS_fnc_missionTasks;" \n
                         "	""REINFORCEMENTS_ARRIVED"" call BIS_fnc_missionConversations;" \n
                         "	""MARKER_ATTACK_ARROW"" setMarkerAlpha 0;" \n
                         "" \n
                         "	// Send USA Forces" \n
                         "	private [""_wp""];" \n
                         "	(getMissionLayerEntities ""LAYER_COUNTERATTACK"" # 0) call EP_fnc_showUnits;" \n
                         "	{" \n
                         "		_x setCombatBehaviour ""AWARE"";" \n
                         "		_x setCombatMode ""RED"";" \n
                         "		{vehicle _x limitSpeed 10} forEach units _x;" \n
                         "		_wp = _x addWaypoint [getMarkerPos ""WP_CONTACT_POS"", 0];" \n
                         "		_wp setWaypointFormation ""LINE"";" \n
                         "		_wp setWaypointType ""MOVE"";" \n
                         "		_wp = _x addWaypoint [getMarkerPos ""MARKER_AA_POS"", 0];" \n
                         "		_wp setWaypointType ""SAD"";" \n
                         "		_wp setWaypointBehaviour ""COMBAT"";" \n
                         "	} forEach (getMissionLayerEntities ""LAYER_COUNTERATTACK"" # 2);" \n
                         "" \n
                         "	// Send Russia Forces" \n
                         "	private [""_rusGroups""];" \n
                         "	_rusGroups = [g_Reinf_Infantry, group o_BMP, group o_BTR, group EP_Player];" \n
                         "	{" \n
                         "		_x setCombatBehaviour ""COMBAT"";" \n
                         "		_x setCombatMode ""RED"";" \n
                         "		{vehicle _x limitSpeed 10} forEach units _x;" \n
                         "		_wp = _x addWaypoint [getMarkerPos ""WP_CONTACT_POS"", 0];" \n
                         "		_wp setWaypointFormation ""LINE"";" \n
                         "		_wp = _x addWaypoint [getMarkerPos ""MARKER_VILLAGE"", 0];" \n
                         "	} forEach _rusGroups;" \n
                         "" \n
                         "	sleep 2;" \n
                         "	""ATTACK_VILLAGE"" call BIS_fnc_missionTasks;" \n
                         "	sleep 2;" \n
                         "	savegame;" \n
                         "	sleep 5;" \n
                         "	playMusic ""LeadTrack01a_F_Jets"";" \n
                         "}" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Contact_on_the_w">*/
                                class Contact_on_the_w
                                {
                                        itemno = 7;
                                        priority = 0.000000;
                                        to="Report";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(isNil ""EP_CONTACT"")"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Report">*/
                class Report
                {
                        name = "Report";
                        itemno = 8;
                        init = /*%FSM<STATEINIT""">*/"""ATTACK_CONTACT"" spawn BIS_fnc_missionConversations;" \n
                         "" \n
                         "private _usaUnitsCount = (count (getMissionLayerEntities ""LAYER_COUNTERATTACK"" # 0));"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Casualties">*/
                                class Casualties
                                {
                                        itemno = 9;
                                        priority = 1.000000;
                                        to="Retreat";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"( !(alive o_BMP && canMove o_BMP) || !(alive o_BTR && canMove o_BTR) ) &&" \n
                                         "( (count units g_Reinf_Infantry) < 5 || (count (units group EP_Player)) == 1)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Enemy_Killed">*/
                                class Enemy_Killed
                                {
                                        itemno = 11;
                                        priority = 0.000000;
                                        to="Go_Attack_Base_With";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"({alive _x} count (getMissionLayerEntities ""LAYER_COUNTERATTACK"" # 0)) < _usaUnitsCount * 0.2"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Go_Attack_Base_With">*/
                class Go_Attack_Base_With
                {
                        name = "Go_Attack_Base_With";
                        itemno = 12;
                        init = /*%FSM<STATEINIT""">*/"EP_DESTROY_TRUCKS = true;" \n
                         "" \n
                         "[] spawn {" \n
                         "	// Kill Remaining Enemy" \n
                         "	{" \n
                         "		if (alive _x) then {" \n
                         "			sleep selectRandom [0.3, 0.5, 0.7];" \n
                         "			_x setDamage 1;" \n
                         "		}" \n
                         "	} forEach (getMissionLayerEntities ""LAYER_COUNTERATTACK"" # 0);" \n
                         "	(getMissionLayerEntities ""LAYER_SUPPLY_BASE_DEFENDER""  # 0) call EP_fnc_showUnits;" \n
                         "" \n
                         "	// Comms and Tasks" \n
                         "	""DESTROY_SUPPLY_TRUCKS"" call BIS_fnc_missionConversations;" \n
                         "	sleep 2;" \n
                         "	""DESTROY_SUPPLY_TRUCKS"" call BIS_fnc_missionTasks;" \n
                         "	""ATTACK_VILLAGE"" call BIS_fnc_missionTasks;" \n
                         "	""MARKER_SUPPLY_BASE"" setMarkerAlpha 1;" \n
                         "	" \n
                         "	// New WPs" \n
                         "	private [""_grp"", ""_wp""];" \n
                         "	_grp = group EP_Player;" \n
                         "" \n
                         "	{_x limitSpeed 60} forEach units _grp;" \n
                         "	{ deleteWaypoint _x } forEachReversed waypoints _grp;" \n
                         "	_wp = _grp addWaypoint [getMarkerPos ""WP_SUPPLY_BASE"", 0];" \n
                         "	_wp setWaypointBehaviour ""AWARE"";" \n
                         "	_wp setWaypointCombatMode ""RED"";" \n
                         "" \n
                         "	// Trucks" \n
                         "	{_x engineOn true} forEach (getMissionLayerEntities ""LAYER_SUPPLY_TRUCKS"" # 0);" \n
                         "	sleep 2;" \n
                         "	savegame;" \n
                         "	sleep 5;" \n
                         "	playMusic ""CUP_A2BAF_Jackals"";" \n
                         "}"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Trucks_KIA">*/
                                class Trucks_KIA
                                {
                                        itemno = 16;
                                        priority = 2.000000;
                                        to="Report_1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"{alive _x || canMove _x} count (getMissionLayerEntities ""LAYER_SUPPLY_TRUCKS"" # 0) == 0"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Casualties">*/
                                class Casualties
                                {
                                        itemno = 15;
                                        priority = 1.000000;
                                        to="Retreat";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(count units group EP_Player) == 1"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Defenders_KIA">*/
                                class Defenders_KIA
                                {
                                        itemno = 25;
                                        priority = 0.000000;
                                        to="Report_2";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"{alive _x} count units GROUP_SUPPLY_BASE == 0"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Retreat">*/
                class Retreat
                {
                        name = "Retreat";
                        itemno = 13;
                        init = /*%FSM<STATEINIT""">*/"EP_CASUALTIES = true;" \n
                         "" \n
                         "if (isNil ""EP_DESTROY_TRUCKS"") then {" \n
                         "	""RETREAT"" spawn BIS_fnc_missionConversations;" \n
                         "	[] spawn {" \n
                         "		private [""_rusGroups""];" \n
                         "		[""ATTACK_VILLAGE"", ""FAILED""] call BIS_fnc_taskSetState;" \n
                         "		_rusGroups = [g_Reinf_Infantry, group o_BMP, group o_BTR, group EP_Player];" \n
                         "		{" \n
                         "			{ deleteWaypoint _x } forEachReversed waypoints _x;" \n
                         "			_x addWaypoint [getMarkerPos ""MARKER_AA_POST"", 0];" \n
                         "		} forEach _rusGroups;" \n
                         "	};" \n
                         "} else {" \n
                         "	""RETREAT_TRUCKS"" spawn BIS_fnc_missionConversations;" \n
                         "	[] spawn {" \n
                         "		private [""_grp""];" \n
                         "		[""DESTROY_SUPPLY_TRUCKS"", ""FAILED""] call BIS_fnc_taskSetState;" \n
                         "		_grp = group EP_Player;" \n
                         "		{ deleteWaypoint _x } forEachReversed waypoints _grp;" \n
                         "		_grp addWaypoint [getMarkerPos ""MARKER_AA_POST"", 0];" \n
                         "	};" \n
                         "};" \n
                         "" \n
                         "_time = time + 60;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Retreated">*/
                                class Retreated
                                {
                                        itemno = 14;
                                        priority = 0.000000;
                                        to="END";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > _time;"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Report_1">*/
                class Report_1
                {
                        name = "Report_1";
                        itemno = 17;
                        init = /*%FSM<STATEINIT""">*/"""TRUCKS_DESTROYED"" spawn BIS_fnc_missionConversations;" \n
                         """MARKER_SUPPLY_BASE_DONE"" setMarkerAlpha 1;" \n
                         "_time = time + 60;" \n
                         "" \n
                         "[] spawn {" \n
                         "	private [""_grp""];" \n
                         "	""DESTROY_SUPPLY_TRUCKS"" call BIS_fnc_missionTasks;" \n
                         "	_grp = group EP_Player;" \n
                         "	{ deleteWaypoint _x } forEachReversed waypoints _grp;" \n
                         "	_grp addWaypoint [getMarkerPos ""MARKER_AA_POST"", 0];" \n
                         "}"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Retreated">*/
                                class Retreated
                                {
                                        itemno = 14;
                                        priority = 0.000000;
                                        to="END";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > _time;"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "END">*/
                class END
                {
                        name = "END";
                        itemno = 20;
                        init = /*%FSM<STATEINIT""">*/"if (isNil ""EP_CASUALTIES"") then {" \n
                         "	[""Win""] call BIS_fnc_endMission;" \n
                         "} else {" \n
                         "	[""Fail"", false] call BIS_fnc_endMission;" \n
                         "}"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
