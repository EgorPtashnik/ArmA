                                        condition=/*%FSM<CONDITION""">*/"(isNil ""EP_BASE_SEE_AMMO"") && {cursorTarget in [EP_BASE_AMMO_TRUCK_1, EP_BASE_AMMO_TRUCK_2, EP_BASE_AMMO_TRUCK_3]}"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"""BASE_SEE_AMMO"" spawn BIS_fnc_missionConversations;" \n
                                         "EP_BASE_SEE_AMMO = true;"/*%FSM</ACTION""">*/;
