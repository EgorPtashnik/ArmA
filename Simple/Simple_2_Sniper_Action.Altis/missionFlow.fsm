                        name = "Comms___Task";
                        itemno = 21;
                        init = /*%FSM<STATEINIT""">*/"" \n
                         "// Scout Route" \n
                         "{ _x disableAI ""MOVE""} forEach units EP_GROUP_SCOUT;	" \n
                         "EP_GROUP_SCOUT addWaypoint [getMarkerPos ""EP_WP_SCOUT_2"", 0];" \n
                         "EP_GROUP_SCOUT addWaypoint [getMarkerPos ""EP_WP_SCOUT_3"", 0];" \n
                         "_wp = EP_GROUP_SCOUT addWaypoint [getMarkerPos ""EP_WP_SCOUT_4"", 0];" \n
                         "_wp setWaypointStatements [""true"", ""EP_SCOUT_IN_POSITION = true;""];" \n
                         "" \n
                         "_thread = [] spawn {" \n
                         "" \n
                         "	sleep 2;" \n
                         "" \n
                         "	""KILL_STATIC_PATROL"" call BIS_fnc_missionTasks;" \n
                         "	""EP_MARKER_STATIC_PATROL_KIA"" setMarkerAlpha 1;" \n
                         "" \n
                         "	sleep 2;" \n
                         "" \n
                         "	""STATIC_PATROL_KIA"" call BIS_fnc_missionConversations;" \n
                         "" \n
                         "	sleep 2;" \n
                         "" \n
                         "	""SCOUT_OBEY"" call BIS_fnc_missionConversations;" \n
                         "	player setVariable [""SUPPORT_MENU_ITEM"", [player, ""SCOUT_GO""] call BIS_fnc_addCommMenuItem];" \n
                         "	{_x enableAI ""MOVE""} forEach units EP_GROUP_DYNAMIC_PATROL;" \n
                         "" \n
                         "	// Dynamic Patrol EHs" \n
                         "	EP_RADIOMAN addEventHandler [""Hit"", {" \n
                         "		[] spawn {" \n
                         "			sleep 10;" \n
                         "			if (alive EP_RADIOMAN) then {" \n
                         "				EP_RADIOMAN_HIT = true;" \n
                         "			};" \n
                         "		};" \n
                         "		EP_RADIOMAN removeEventHandler [_thisEvent, _thisEventHandler];" \n
                         "	}];" \n
                         "" \n
                         "	{" \n
                         "		_x addEventHandler [""Hit"", {" \n
                         "			if (alive EP_RADIOMAN) then {" \n
                         "				EP_RADIOMAN_HIT = true;" \n
                         "			};" \n
                         "			_x removeEventHandler [_thisEvent, _thisEventHandler];" \n
                         "		}];" \n
                         "	} forEach ( (units EP_GROUP_DYNAMIC_PATROL) - [EP_RADIOMAN]);" \n
                         "			" \n
                         "" \n
                         "	savegame;" \n
                         "}" \n
                         "" \n
                         ""/*%FSM</STATEINIT""">*/;
