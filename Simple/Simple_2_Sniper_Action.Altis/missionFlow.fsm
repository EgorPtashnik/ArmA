                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Support__Report">*/
                                class Support__Report
                                {
                                        itemno = 68;
                                        priority = 0.000000;
                                        to="Base_Event_Loop";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(isNil ""EP_MARK_TARGET"")"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"private [""_cursorPointerPos"", ""_markedTargets""];" \n
                                         "_cursorPointerPos = screenToWorld [0.5,0.5];" \n
                                         "" \n
                                         "// Push Marked Targets Coordinates" \n
                                         "_markedTargets = player getVariable [""MARKED_TARGETS"", []];" \n
                                         "_markedTargets pushBack [_cursorPointerPos, false];" \n
                                         "" \n
                                         "player setVariable [""MARKED_TARGETS"", _markedTargets];" \n
                                         "" \n
                                         "if (count _markedTargets == 2) then {" \n
                                         "	[player, player getVariable ""SUPPORT_MARK_TARGET""] call BIS_fnc_removeCommMenuItem;" \n
                                         "} else {" \n
                                         "	""BASE_MARK_TARGET"" spawn BIS_fnc_missionConversations;" \n
                                         "};" \n
                                         "EP_MARK_TARGET = nil;" \n
                                         "" \n
                                         ""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Support__Call_Ar">*/
                                class Support__Call_Ar
                                {
                                        itemno = 71;
                                        priority = 0.000000;
                                        to="Base_Event_Loop";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(isNil ""EP_CALL_ARTILLERY"")"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"if ({ (_x # 1) == false} count (player getVariable [""MARKED_TARGETS"", []]) == 0) then {" \n
                                         "	""BASE_NO_MARKED_TARGETS"" spawn BIS_fnc_missionConversations;" \n
                                         "	EP_CALL_ARTILLERY = nil;" \n
                                         "} else {" \n
                                         "	EP_CALL_ARTILLERY = nil;" \n
                                         "	[] spawn {" \n
                                         "		""BASE_CALL_ARTILLERY"" call BIS_fnc_missionConversations;" \n
                                         "		" \n
                                         "		private [""_coordinates"", ""_pos"", ""_isFired"", ""_mag""];" \n
                                         "		_coordinates = player getVariable ""MARKED_TARGETS"";" \n
                                         "" \n
                                         "		if (count _coordinates == 2) then {" \n
                                         "			[player, player getVariable ""SUPPORT_CALL_ARTILLERY""] call BIS_fnc_removeCommMenuItem;" \n
                                         "		};" \n
                                         "" \n
                                         "		{" \n
                                         "			_isFired = _x # 1;" \n
                                         "			if !(_isFired) then {" \n
                                         "				_x set [1, true];" \n
                                         "				_pos = _x # 0;" \n
                                         "				_mag = (getArtilleryAmmo [EP_ARTI]) # 0;" \n
                                         "				EP_ARTI doArtilleryFire [_pos, _mag, 1];" \n
                                         "				waitUntil {sleep 1; unitReady EP_ARTI};" \n
                                         "			};" \n
                                         "		} forEach _coordinates;" \n
                                         "" \n
                                         "		player setVariable [""MARKED_TARGETS"", _coordinates];" \n
                                         "	};" \n
                                         "};" \n
                                         ""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
