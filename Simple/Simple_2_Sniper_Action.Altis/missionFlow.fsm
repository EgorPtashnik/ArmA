                /*%FSM<STATE "End_Mission">*/
                class End_Mission
                {
                        name = "End_Mission";
                        itemno = 87;
                        init = /*%FSM<STATEINIT""">*/"[] spawn {" \n
                         "	""SCOUT_RETREATED"" call BIS_fnc_missionConversations;" \n
                         "" \n
                         "	sleep 5;" \n
                         "" \n
                         "	// Create explosions" \n
                         "	private [""_charge""];" \n
                         "	{_x setDamage 1} forEach [EP_BASE_AMMO_TRUCK_1, EP_BASE_AMMO_TRUCK_2, EP_BASE_AMMO_TRUCK_3];" \n
                         "	{" \n
                         "		_charge = ""DemoCharge_Remote_Ammo_Scripted"" createVehicle (getMarkerPos _x);" \n
                         "		_charge setDamage 1;" \n
                         "	} forEach [""POS_BASE_AMMO_CACHE_1"", ""POS_BASE_AMMO_CACHE_2""];" \n
                         "" \n
                         "	sleep 5;" \n
                         "" \n
                         "	""Win"" call BIS_fnc_endMission;" \n
                         "}"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
