                /*%FSM<STATE "Send_QRF">*/
                class Send_QRF
                {
                        name = "Send_QRF";
                        itemno = 81;
                        init = /*%FSM<STATEINIT""">*/"// Send QRF depending on Officer's State + Report" \n
                         """BASE_CAPTURED"" spawn BIS_fnc_missionConversations;" \n
                         """BASE"" call BIS_fnc_missionTasks;" \n
                         "{(units _x) call EP_fnc_showUnits} forEach (getMissionLayerEntities ""LAYER_QRF"" # 2);" \n
                         "" \n
                         "_wp = EP_GROUP_QRF addWaypoint [EP_QRF_CAR, 0];" \n
                         "_wp setWaypointType ""GETIN"";" \n
                         "_wp setWaypointSpeed ""FULL"";" \n
                         "" \n
                         "_wp = EP_GROUP_QRF addWaypoint [getMarkerPos ""EP_WP_QRF_UNLOAD"", 0];" \n
                         "_wp setWaypointBehaviour ""AWARE"";" \n
                         "_wp setWaypointType ""GETOUT"";" \n
                         "_wp setWaypointSpeed ""FULL"";" \n
                         "" \n
                         "_wp = EP_GROUP_QRF addWaypoint [getMarkerPos ""EP_WP_QRF_SAD"", 0];" \n
                         "_wp setWaypointBehaviour ""COMBAT"";" \n
                         "_wp setWaypointType ""SAD"";" \n
                         "_wp setWaypointSpeed ""FULL"";" \n
                         "" \n
                         "_time = time + 180;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Scout_KIA">*/
