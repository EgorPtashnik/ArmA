class FSM
{
        fsmName = "missionFlow";
        class States
        {
                /*%FSM<STATE "start">*/
                class start
                {
                        name = "start";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"private [""_time"", ""_thread"", ""_wp"", ""_patrolUnits""];" \n
                         "" \n
                         "_patrolUnits = (units EP_GROUP_DYNAMIC_PATROL) + [EP_STATIC_PATROL_1, EP_STATIC_PATROL_2, EP_STATIC_PATROL_3];"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "mission_started">*/
                                class mission_started
                                {
                                        itemno = 1;
                                        priority = 0.000000;
                                        to="Insertion";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(isNil ""EP_MISSION_STARTED"")"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Insertion">*/
                class Insertion
                {
                        name = "Insertion";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"[] spawn {" \n
                         "	if !(EP_SKIP_INTRO) then {" \n
                         "		private [""_thread""];" \n
                         "		sleep 3;" \n
                         "" \n
                         "		enableRadio true;" \n
                         "		enableSentences true;" \n
                         "		" \n
                         "		[""EP_BLACK_SCREEN"", false] call BIS_fnc_blackIn;" \n
                         "		0 fadeMusic 1;" \n
                         "		[1, ""BLACK"", 7, 1] spawn BIS_fnc_fadeEffect;" \n
                         "" \n
                         "		sleep 7;" \n
                         "" \n
                         "		_thread = [[" \n
                         "			[""Operation 'Silent Surgeon'"", ""<t align = 'center' shadow = '1' size = '0.7'>%1</t><br/>""]," \n
                         "			[""Captain Aaron Lorant, British Special Forces"", ""<t align = 'center' shadow = '1' size = '0.7'>%1</t><br/>""]," \n
                         "			[format [""Southern Altis, %1"", [dayTime, ""HH:MM""] call BIS_fnc_timeToString]," \n
                         "			""<t align = 'center' shadow = '1' size = '0.7'>%1</t><br/>"", 15]" \n
                         "		], safeZoneW + safeZoneX * 2.3, safeZoneH + safeZoneY * 2] spawn BIS_fnc_typeText;" \n
                         "		" \n
                         "		waitUntil {sleep 1; scriptDone _thread};" \n
                         "" \n
                         "		[1, 1.5, false, true] call BIS_fnc_cinemaBorder;" \n
                         "	};" \n
                         "" \n
                         "	sleep 2;" \n
                         "" \n
                         "	""INSERTION"" call BIS_fnc_missionConversations;" \n
                         "	""GET_TO_POSITION"" call BIS_fnc_missionTasks;" \n
                         "}" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Compromised">*/
                                class Compromised
                                {
                                        itemno = 22;
                                        priority = 1.000000;
                                        to="Fail_Compromised";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"{(_x knowsAbout player) >= 2} count _patrolUnits > 0 ||" \n
                                         "" \n
                                         "{" \n
                                         "	private _scout = _x;" \n
                                         "	{" \n
                                         "		(_x knowsAbout _scout) >= 2" \n
                                         "	} count _patrolUnits > 0" \n
                                         "} count (units EP_GROUP_SCOUT) > 0"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "In_Position">*/
                                class In_Position
                                {
                                        itemno = 9;
                                        priority = 0.000000;
                                        to="Task___Comms";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"player distance2D (getMarkerPos ""EP_MARKER_SNIPER_POSITION"") < 10"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Task___Comms">*/
                class Task___Comms
                {
                        name = "Task___Comms";
                        itemno = 10;
                        init = /*%FSM<STATEINIT""">*/"_thread = [] spawn {" \n
                         "	""IN_POSITION"" call BIS_fnc_missionConversations;" \n
                         "	""GET_TO_POSITION"" call BIS_fnc_missionTasks;" \n
                         "" \n
                         "	sleep 5;" \n
                         "" \n
                         "	""SUPPORT_SCOUT"" call BIS_fnc_missionTasks;" \n
                         "}"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Compromised">*/
                                class Compromised
                                {
                                        itemno = 22;
                                        priority = 1.000000;
                                        to="Fail_Compromised";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"{(_x knowsAbout player) >= 2} count _patrolUnits > 0 ||" \n
                                         "" \n
                                         "{" \n
                                         "	private _scout = _x;" \n
                                         "	{" \n
                                         "		(_x knowsAbout _scout) >= 2" \n
                                         "	} count _patrolUnits > 0" \n
                                         "} count (units EP_GROUP_SCOUT) > 0"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Wait_Comms">*/
                                class Wait_Comms
                                {
                                        itemno = 11;
                                        priority = 0.000000;
                                        to="Send_Scout";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"scriptDone _thread"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Send_Scout">*/
                class Send_Scout
                {
                        name = "Send_Scout";
                        itemno = 12;
                        init = /*%FSM<STATEINIT""">*/"private [""_wp"", ""_pos""];" \n
                         "" \n
                         "{_x enableAI ""MOVE""} forEach units EP_GROUP_SCOUT;" \n
                         "" \n
                         "_pos = getMarkerPos ""EP_WP_SCOUT_1"";" \n
                         "_wp = EP_GROUP_SCOUT addWaypoint [_pos, 0];" \n
                         "_wp setWaypointStatements [""true"", ""EP_WP_SCOUT_1_DONE = true""]" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Compromised">*/
                                class Compromised
                                {
                                        itemno = 22;
                                        priority = 1.000000;
                                        to="Fail_Compromised";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"{(_x knowsAbout player) >= 2} count _patrolUnits > 0 ||" \n
                                         "" \n
                                         "{" \n
                                         "	private _scout = _x;" \n
                                         "	{" \n
                                         "		(_x knowsAbout _scout) >= 2" \n
                                         "	} count _patrolUnits > 0" \n
                                         "} count (units EP_GROUP_SCOUT) > 0"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Scout_In_Positio">*/
                                class Scout_In_Positio
                                {
                                        itemno = 13;
                                        priority = 0.000000;
                                        to="Comms";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(isNil ""EP_WP_SCOUT_1_DONE"")"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Comms">*/
                class Comms
                {
                        name = "Comms";
                        itemno = 14;
                        init = /*%FSM<STATEINIT""">*/"_thread = [] spawn {" \n
                         "	savegame;" \n
                         "	" \n
                         "	sleep 1;" \n
                         "" \n
                         "	""SCOUT_IN_POSITION"" call BIS_fnc_missionConversations;" \n
                         "	" \n
                         "	// Update Scout Position Loop" \n
                         "	[] spawn {" \n
                         "		EP_SHARE_SCOUT_POS = true;" \n
                         "		""EP_MARKER_GROUP_SCOUT"" setMarkerAlpha 1;" \n
                         "" \n
