                                        condition=/*%FSM<CONDITION""">*/"{alive _x} count (units EP_GROUP_SCOUT) == 0"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
