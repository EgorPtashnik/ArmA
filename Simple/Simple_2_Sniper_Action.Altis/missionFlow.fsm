                                         "_wp setWaypointFormation ""WEDGE"";" \n
                                         "" \n
                                         """BASE_SCOUT_ATTACK"" spawn BIS_fnc_missionConversations;" \n
                                         "" \n
                                         "EP_SCOUT_ATTACK = nil;"/*%FSM</ACTION""">*/;
