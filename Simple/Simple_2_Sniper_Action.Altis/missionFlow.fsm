                                        condition=/*%FSM<CONDITION""">*/"(isNil ""EP_BASE_SEE_STATIC"") && {cursorTarget in [EP_BASE_STATICDEF, EP_BASE_STATICDEF_GUN]}"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"""BASE_STATIC"" call BIS_fnc_missionTasks;" \n
                                         "EP_BASE_SEE_STATIC = true;"/*%FSM</ACTION""">*/;
