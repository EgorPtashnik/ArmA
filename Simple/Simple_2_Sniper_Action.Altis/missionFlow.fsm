                                        condition=/*%FSM<CONDITION""">*/"(isNil ""EP_BASE_STATIC_KIA"") && {!(alive EP_BASE_STATICDEF)}"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"""BASE_STATIC"" call BIS_fnc_missionTasks;" \n
                                         "EP_BASE_STATIC_KIA = true;"/*%FSM</ACTION""">*/;
