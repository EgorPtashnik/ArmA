                {
                        name = "Scout_Retreat";
                        itemno = 84;
                        init = /*%FSM<STATEINIT""">*/"{ deleteWaypoint _x } forEachReversed waypoints EP_GROUP_SCOUT;" \n
                         "" \n
                         "EP_GROUP_SCOUT setBehaviourStrong ""CARELESS"";" \n
                         "EP_GROUP_SCOUT setSpeedMode ""FULL"";" \n
                         "{_x setUnitPos ""UP""; _x enableStamina false} forEach units EP_GROUP_SCOUT;" \n
                         "" \n
                         "_wp = EP_GROUP_SCOUT addWaypoint [getPos leader EP_GROUP_SCOUT, 0];" \n
                         "_wp setWaypointType ""MOVE"";" \n
                         "" \n
                         "_wp = EP_GROUP_SCOUT addWaypoint [getMarkerPos ""EP_WP_SCOUT_RETREAT_1"", 0];" \n
                         "_wp setWaypointStatements [""true"", ""EP_SCOUT_RETREATED = true;""];" \n
                         "" \n
                         "_wp = EP_GROUP_SCOUT addWaypoint [getMarkerPos ""EP_WP_SCOUT_RETREAT_2"", 0];" \n
                         "" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
