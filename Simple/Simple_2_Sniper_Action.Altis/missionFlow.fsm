                                        condition=/*%FSM<CONDITION""">*/"!(isNil ""EP_SCOUT_ATTACK"")"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"{_x enableAI ""MOVE""; _x setUnitPos ""AUTO""} forEach units EP_GROUP_SCOUT;" \n
                                         "" \n
                                         "_wp = EP_GROUP_SCOUT addWaypoint [getMarkerPos ""EP_WP_SCOUT_5"", 0];" \n
                                         "_wp setWaypointType ""SAD"";" \n
                                         "_wp setWaypointBehaviour ""COMBAT"";" \n
