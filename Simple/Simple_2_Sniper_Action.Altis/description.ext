};

//// To add: [player,"CustomSupportMenuItem"] call BIS_fnc_addCommMenuItem;
class CfgCommunicationMenu {
	class SCOUT_GO {
		text = "Scout: Go";
		submenu = "";
		expression = "EP_SCOUT_GO = true;";
		icon = "a3\missions_f_oldman\data\img\holdactions\holdaction_follow_start_ca.paa";
		cursor = "";
		enable = "1";
		removeAfterExpressionCall = 1;
	};
	
	class SCOUT_STOP {
		text = "Scout: Stop";
		submenu = "";
		expression = "EP_SCOUT_STOP = true;";
		icon = "a3\missions_f_oldman\data\img\holdactions\holdaction_follow_stop_ca.paa";
		cursor = "";
		enable = "1";
		removeAfterExpressionCall = 1;
	};

	class MARK_TARGET {
		text = "Report Target Coordinates";
		submenu = "";
		expression = "EP_MARK_TARGET = true;";
		icon = "\a3\Ui_f\data\GUI\Cfg\CommunicationMenu\call_ca.paa";
		cursor = "a3\ui_f\data\gui\cfg\cursors\hc_overmission_gs.paa";
		enable = "1";
		removeAfterExpressionCall = 0;
	};

	class CALL_ARTILLERY {
		text = "Call Artillery";
		submenu = "";
		expression = "EP_CALL_ARTILLERY = true;";
		icon = "\a3\ui_f\data\igui\cfg\simpletasks\types\destroy_ca.paa";
		cursor = "\a3\ui_f\data\igui\cfg\simpletasks\types\destroy_ca.paa";
		enable = "1";
		removeAfterExpressionCall = 1;
	};

	class SCOUT_ATTACK {
		text = "Scout: Attack";
		submenu = "";
		expression = "EP_SCOUT_ATTACK = true;";
		icon = "\A3\ui_f\data\map\markers\nato\b_recon.paa";
		cursor = "\A3\ui_f\data\map\markers\nato\b_recon.paa";
		enable = "1";
		removeAfterExpressionCall = 1;
	};
};

