                         "	""blashka_2"" call BIS_fnc_missionTasks;" \n
                         "	""blashka_3"" call BIS_fnc_missionTasks;" \n
                         "	""mrkBlashka"" setMarkerAlpha 1;" \n
                         "	""mrkAPCs"" setMarkerAlpha 1;" \n
                         "" \n
                         "	sleep 2;" \n
                         "	oHunter lock false;" \n
                         "	{_x setUnitPos ""AUTO""; _x setCaptive false} forEach units grpPlayer;" \n
                         "	""getInHunter"" call BIS_fnc_missionConversations;" \n
