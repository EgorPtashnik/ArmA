                         "" \n
                         "	sleep 2;" \n
                         "" \n
                         "	""startDone"" call BIS_fnc_missionConversations;" \n
                         "" \n
                         "	sleep 3;" \n
                         "	""blashkaNeedHelp"" call BIS_fnc_missionConversations;" \n
                         "" \n
                         "	sleep 2;" \n
                         "	""blashka"" call BIS_fnc_missionTasks;" \n
