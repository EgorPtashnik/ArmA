                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "See_spotters">*/
                                class See_spotters
                                {
                                        itemno = 3;
                                        priority = 0.000000;
                                        to="Remember_ROE";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"//{_x distance _dest < 1550} count _helis > 0" \n
                                         "{_x distance _dest < 1600} count _helis > 0"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
