                        name = "Extracted_1";
                        itemno = 37;
                        init = /*%FSM<STATEINIT""">*/"private [""_conv""];" \n
                         "_conv = ""45_Extracted"" spawn BIS_fnc_missionConversations;" \n
                         "" \n
                         "[] spawn {" \n
                         "	scriptName ""missionFlow.fsm: extracted"";" \n
                         "	" \n
                         "	sleep 2;" \n
                         "	" \n
                         "	// Artillery strike" \n
                         "	[] spawn {" \n
                         "		scriptName ""missionFlow.fsm: artillery strike"";" \n
                         "		" \n
                         "		private [""_center"", ""_firstRound""];" \n
                         "		_center = markerPos ""BIS_town"";" \n
                         "		_firstRound = true;" \n
                         "		" \n
                         "		while {true} do {" \n
                         "			// Find a random position" \n
                         "			private [""_pos""];" \n
                         "			_pos = [_center, random 150, random 360] call BIS_fnc_relPos;" \n
                         "			_pos set [2, 500];" \n
                         "			" \n
                         "			// Spawn rocket" \n
                         "			private [""_rocket""];" \n
                         "			_rocket = createVehicle [""R_230mm_HE"", _pos, [], 0, ""NONE""];" \n
                         "			_rocket setPos _pos;" \n
                         "			[_rocket, 180, 0] call BIS_fnc_setPitchBank;" \n
                         "			_rocket setVelocity [0,0,-1];" \n
                         "			" \n
                         "			sleep 2;" \n
                         "		};" \n
                         "	};" \n
                         "	" \n
                         "	sleep 2;" \n
