                                        condition=/*%FSM<CONDITION""">*/"{_unit = _x; {_unit distance _x < 2} count [BIS_crew1, BIS_crew2] > 0} count (units BIS_playerGroup) > 0"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
