                /*%FSM<STATE "Take_off">*/
                class Take_off
                {
                        name = "Take_off";
                        itemno = 30;
                        init = /*%FSM<STATEINIT""">*/"// Update task" \n
                         "[""BIS_extract"", ""SUCCEEDED""] call BIS_fnc_missionTasks;" \n
                         "" \n
                         "// Add waypoints for helicopter" \n
                         "private [""_group""];" \n
                         "_group = group BIS_extractD;" \n
                         "" \n
                         "{" \n
                         "	private [""_wp""];" \n
                         "	_wp = _group addWaypoint [_x, 0];" \n
                         "	_wp setWaypointSpeed ""NORMAL"";" \n
                         "	_wp setWaypointType ""MOVE"";" \n
                         "	if (_forEachIndex == 0) then {_group setCurrentWaypoint _wp};" \n
                         "} forEach [markerPos ""BIS_earlyDest"", markerPos ""BIS_heliDest""];" \n
                         "" \n
                         "// Let helicopter take off" \n
                         "BIS_extract flyInHeight 50;" \n
                         "BIS_extract lock true;" \n
                         "{" \n
                         "	if (!(isPlayer _x)) then {" \n
                         "		// Make units invulnerable" \n
                         "		_x allowDamage false;" \n
                         "		" \n
                         "		// Ensure raised weapons of ramp gunners" \n
                         "		_x setBehaviour ""COMBAT"";" \n
                         "	};" \n
                         "} forEach ([BIS_crew1, BIS_crew2] + units BIS_playerGroup + units BIS_group2);" \n
                         "" \n
                         "// Fade volume" \n
                         "BIS_inHeli = true;" \n
                         "publicVariable ""BIS_inHeli"";" \n
                         "[[15, 0.4], ""fadeSound""] call BIS_fnc_MP;" \n
                         "" \n
                         "[] spawn {" \n
                         "	scriptName ""missionFlow.fsm: take off"";" \n
                         "	sleep 0.5;" \n
                         "	""40_All_In"" spawn BIS_fnc_missionConversations;" \n
                         "};"/*%FSM</STATEINIT""">*/;
