                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"//{_x distance _dest < 500} count _helis > 0" \n
                                         "{_x distance _dest < 300} count _helis > 0"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Observe">*/
                class Observe
                {
                        name = "Observe";
                        itemno = 6;
                        init = /*%FSM<STATEINIT""">*/"""10_Located"" spawn BIS_fnc_missionConversations;" \n
                         "" \n
                         "// Succeed task" \n
                         "[""BIS_locate"", ""SUCCEEDED""] call BIS_fnc_missionTasks;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Engaged">*/
                                class Engaged
                                {
                                        itemno = 40;
                                        priority = 0.000000;
                                        to="Return_fire";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"BIS_engaged"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Pull_out">*/
                class Pull_out
                {
                        name = "Pull_out";
                        itemno = 8;
                        init = /*%FSM<STATEINIT""">*/"enableSentences false;" \n
                         "" \n
                         """15_Technical"" spawn BIS_fnc_missionConversations;" \n
                         "" \n
                         "// Have helicopters take cover" \n
                         "{" \n
                         "	private [""_heli"", ""_group""];" \n
                         "	_heli = _x;" \n
                         "	_group = group driver _heli;" \n
                         "	" \n
                         "	// Decrease altitude" \n
                         "	_heli flyInHeight 25;" \n
                         "	" \n
                         "	// Delete existing waypoints" \n
                         "	while {count waypoints _group > 0} do {deleteWaypoint (waypoints _group select 0)};" \n
                         "	" \n
                         "	// Determine cover position" \n
                         "	private [""_cover""];" \n
                         "	_cover = format [""BIS_cover%1"", _forEachIndex + 1];" \n
                         "	" \n
                         "	// Add waypoints" \n
                         "	private [""_wp1"", ""_wp2""];" \n
                         "	_wp1 = _group addWaypoint [markerPos _cover, 0];" \n
                         "	_wp2 = _group addWaypoint [markerPos _cover, 0];" \n
                         "	" \n
                         "	_wp1 setWaypointSpeed ""NORMAL"";" \n
                         "	_wp2 setWaypointSpeed ""LIMITED"";" \n
                         "	" \n
                         "	// Make helicopters loiter" \n
                         "	_wp1 setWaypointType ""MOVE"";" \n
                         "	_wp2 setWaypointType ""LOITER"";" \n
                         "	_wp2 setWaypointLoiterRadius 50;" \n
                         "	" \n
                         "	_group setCurrentWaypoint _wp1;" \n
                         "} forEach [BIS_heli1, BIS_heli2];"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "UAV_online">*/
                                class UAV_online
                                {
                                        itemno = 50;
                                        priority = 0.000000;
                                        to="Destroying_wreck";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"BIS_UAVAllowed"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Insert_at_town">*/
                class Insert_at_town
                {
                        name = "Insert_at_town";
                        itemno = 10;
                        init = /*%FSM<STATEINIT""">*/"execVM ""insertion.sqf"";" \n
                         "" \n
                         "private [""_gasSearched"", ""_outpostSearched""];" \n
                         "_gasSearched = false;" \n
                         "_outpostSearched = false;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Searched_gas_sta">*/
                                class Searched_gas_sta
                                {
                                        itemno = 15;
                                        priority = 0.000000;
                                        to="Gas_station_sear";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"BIS_crewLocation != 1" \n
                                         "&&" \n
                                         "BIS_gasSearched" \n
                                         "&&" \n
                                         "!(_gasSearched)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Searched_outpost">*/
                                class Searched_outpost
