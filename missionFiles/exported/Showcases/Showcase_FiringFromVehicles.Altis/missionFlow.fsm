                /*%FSM<STATE "Move_to_extract">*/
                class Move_to_extract
                {
                        name = "Move_to_extract";
                        itemno = 24;
                        init = /*%FSM<STATEINIT""">*/"[] spawn {" \n
                         "	scriptName ""move to extract"";" \n
                         "	" \n
                         "	if (!(isMultiplayer)) then {" \n
                         "		saveGame;" \n
                         "		sleep 1;" \n
                         "	};" \n
                         "	" \n
                         "	// Update crew status" \n
                         "	BIS_crewFound = true;" \n
                         "	BIS_crewStatus = 1;" \n
                         "	{publicVariable _x} forEach [""BIS_crewFound"", ""BIS_crewStatus""];" \n
                         "	" \n
                         "	// Update tasks" \n
                         "	{" \n
                         "		if (BIS_crewLocation == _forEachIndex + 1) then {" \n
                         "			// Succeed the search task for where the crew are" \n
                         "			[_x, ""SUCCEEDED""] call BIS_fnc_missionTasks;" \n
                         "		} else {" \n
                         "			// Cancel the others" \n
                         "			[_x, ""CANCELED""] call BIS_fnc_missionTasks;" \n
                         "		};" \n
                         "	} forEach [""BIS_loc1"", ""BIS_loc2""];" \n
                         "	" \n
                         "	// Add extract task" \n
                         "	""BIS_extract"" call BIS_fnc_missionTasks;" \n
                         "	" \n
                         "	""35_Crew_Found"" spawn BIS_fnc_missionConversations;" \n
                         "	" \n
                         "	// Handle extraction" \n
                         "	execVM ""extraction.sqf"";" \n
                         "};"/*%FSM</STATEINIT""">*/;
