                                        condition=/*%FSM<CONDITION""">*/"BIS_crewLocation != 2" \n
                                         "&&" \n
                                         "BIS_outpostSearched" \n
                                         "&&" \n
                                         "!(_outpostSearched)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
