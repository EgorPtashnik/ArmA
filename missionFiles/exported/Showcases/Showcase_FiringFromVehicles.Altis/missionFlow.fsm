                /*%FSM</STATE>*/
                /*%FSM<STATE "Remember_ROE">*/
                class Remember_ROE
                {
                        name = "Remember_ROE";
                        itemno = 4;
                        init = /*%FSM<STATEINIT""">*/"// Make crash site units flee" \n
                         "BIS_flee = true;" \n
                         "publicVariable ""BIS_flee"";" \n
                         "" \n
                         """05_Sentries"" spawn BIS_fnc_missionConversations;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
