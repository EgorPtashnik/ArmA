                {
                        name = "init_attack_on_e";
                        itemno = 17;
                        init = /*%FSM<STATEINIT""">*/"private _t = time;" \n
                         "{" \n
                         "_x enableSimulation true;" \n
                         "_x hideObject false;" \n
                         "_x disableAI ""MOVE"";" \n
