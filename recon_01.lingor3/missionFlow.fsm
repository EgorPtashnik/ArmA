class FSM
{
        fsmName = "recon_01";
        class States
        {
                /*%FSM<STATE "start">*/
                class start
                {
                        name = "start";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "_">*/
                                class _
                                {
                                        itemno = 1;
                                        priority = 0.000000;
                                        to="Variables__FSMs";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Variables__FSMs">*/
                class Variables__FSMs
                {
                        name = "Variables__FSMs";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"//Comms names" \n
                         "Comms_Player = name EP_Player;" \n
                         "Comms_HQ = ""OVERWATCH"";" \n
                         "Comms_Raven = ""RAVEN"";" \n
                         "" \n
                         "//Initial tasks" \n
                         """Stealth"" call BIS_fnc_missionTasks;" \n
                         """Camp01"" call BIS_fnc_missionTasks;" \n
                         "" \n
                         "execFSM ""FSMs\SpawnBandits.fsm"";"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Intro_Done">*/
                                class Intro_Done
                                {
                                        itemno = 14;
                                        priority = 0.000000;
                                        to="Set_Timer";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!isNil ""EP_IntroDone"""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Gather_group_and">*/
                class Gather_group_and
                {
                        name = "Gather_group_and";
                        itemno = 5;
                        init = /*%FSM<STATEINIT""">*/"""EP_Start"" spawn BIS_fnc_missionConversations;" \n
                         "" \n
                         "private _operators = [EP_Operator01, EP_Operator02, EP_Operator03];" \n
                         "private _grpCobra = group EP_Player;" \n
                         "" \n
                         "//Exit animations" \n
                         "{[_x, ""AnimExit""] call EF_fnc_ambientAnim} forEach _operators;" \n
                         "_operators joinSilent _grpCobra;" \n
                         "_grpCobra setBehaviour ""STEALTH"";" \n
                         "_grpCobra setCombatMode ""BLUE"";" \n
                         "_grpCobra setFormation ""DIAMOND"";" \n
                         "" \n
                         "//Enable detection trigger 1" \n
                         "trg_Detected01 enableSimulation true;" \n
                         "" \n
                         "savegame;" \n
                         "" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Camp_1_CLEAR">*/
                                class Camp_1_CLEAR
                                {
                                        itemno = 11;
                                        priority = 0.000000;
                                        to="Report";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!isNil ""EP_Camp01Bandits"" && " \n
                                         "{EP_Camp01Bandits findIf {alive _x} == -1}"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Detected_at_camp">*/
                                class Detected_at_camp
                                {
                                        itemno = 6;
                                        priority = 0.000000;
                                        to="FAIL__Compromised";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"triggerActivated trg_Detected01"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "FAIL__Compromised">*/
                class FAIL__Compromised
                {
                        name = "FAIL__Compromised";
                        itemno = 7;
                        init = /*%FSM<STATEINIT""">*/"[""Compromised"", false] call BIS_fnc_endMission;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Report">*/
                class Report
                {
                        name = "Report";
                        itemno = 12;
                        init = /*%FSM<STATEINIT""">*/"//Change marker color" \n
                         """mrk_Camp01"" setMarkerColor ""ColorGrey"";" \n
                         "" \n
                         "handle = spawn {" \n
                         "	//Handle task" \n
                         "	sleep 2;" \n
                         "	[""Camp01"", ""SUCCEEDED""] call BIS_fnc_missionTasks;" \n
                         "" \n
                         "	//Comms" \n
                         "	sleep 2;" \n
                         "	""Camp01Clear"" call BIS_fnc_missionConversations;" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "comms_done">*/
                                class comms_done
                                {
                                        itemno = 15;
                                        priority = 0.000000;
                                        to="Add_new_task";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"scriptDone handle"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Camp_2_CLEAR">*/
                                class Camp_2_CLEAR
                                {
                                        itemno = 13;
                                        priority = 0.000000;
                                        to="____FAKE____";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!isNil ""EP_Camp02Bandits"" && " \n
                                         "{EP_Camp02Bandits findIf {alive _x} == -1}"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Detected_at_camp">*/
                                class Detected_at_camp
                                {
                                        itemno = 8;
                                        priority = 0.000000;
                                        to="FAIL__Compromised";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"triggerActivated trg_Detected02"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
