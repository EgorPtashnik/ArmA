                class Add_new_task
                {
                        name = "Add_new_task";
                        itemno = 16;
                        init = /*%FSM<STATEINIT""">*/"""Camp02"" call BIS_fnc_missionTasks;" \n
                         "" \n
                         "savegame;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Detected_at_camp">*/
