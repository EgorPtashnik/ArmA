                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Set_Timer">*/
                class Set_Timer
                {
                        name = "Set_Timer";
                        itemno = 19;
                        init = /*%FSM<STATEINIT""">*/"_t = time;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Timer_60_sec">*/
                                class Timer_60_sec
                                {
                                        itemno = 4;
                                        priority = 0.000000;
                                        to="Gather_group_and";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > _t + 60"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
