                class Fire_at_wreck
                {
                        name = "Fire_at_wreck";
                        itemno = 14;
                        init = /*%FSM<STATEINIT""">*/"// Display firing hint" \n
                         "[[""Vehicle"", ""Firing""]] call BIS_fnc_advHint;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
