                                {
                                        itemno = 8;
                                        priority = 0.000000;
                                        to="Notify_1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(isUAVConnected BIS_UAV)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Connect">*/
                class Connect
                {
                        name = "Connect";
                        itemno = 16;
                        init = /*%FSM<STATEINIT""">*/"// Monitor UAV's ammo" \n
                         "private [""_firedEH""];" \n
                         "_firedEH = BIS_UAV addEventHandler [" \n
                         "	""Fired""," \n
                         "	{" \n
                         "		if (BIS_UAV ammo (weapons BIS_UAV select 0) == 0) then {" \n
                         "			// Track last rocket" \n
                         "			(_this select 6) spawn {" \n
                         "				private [""_projectile""];" \n
                         "				_projectile = _this;" \n
                         "				" \n
                         "				scriptName (format [""UAVControl.fsm: final round check - [%1]"", _projectile]);" \n
                         "				" \n
                         "				waitUntil {!(alive _projectile)};" \n
                         "				" \n
                         "				sleep 1;" \n
                         "				" \n
                         "				// Remove event handler" \n
                         "				BIS_UAV removeEventHandler [""Fired"", BIS_UAV getVariable ""BIS_firedEH""];" \n
                         "				" \n
                         "				// Register that the last round hit" \n
                         "				BIS_finalRound = true;" \n
                         "				publicVariable ""BIS_finalRound"";" \n
                         "			};" \n
                         "		};" \n
                         "	}" \n
                         "];" \n
                         "" \n
                         "BIS_UAV setVariable [""BIS_firedEH"", _firedEH];"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Unconnected">*/
                                class Unconnected
                                {
                                        itemno = 18;
                                        priority = 0.000000;
                                        to="Allow_connect";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(isUAVConnected BIS_UAV)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "UAV_disabled">*/
                                class UAV_disabled
                                {
                                        itemno = 22;
                                        priority = 0.000000;
                                        to="Terminate";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(missionNamespace getVariable [""BIS_UAVAllowed"", false])"/*%FSM</CONDITION""">*/;
