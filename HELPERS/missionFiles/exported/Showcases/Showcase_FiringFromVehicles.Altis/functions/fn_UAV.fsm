                                class In_thermal
                                {
                                        itemno = 13;
                                        priority = 0.000000;
                                        to="Fire_at_wreck";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"currentVisionMode BIS_UAVG == 2"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Notify">*/
                class Notify
                {
                        name = "Notify";
                        itemno = 9;
                        init = /*%FSM<STATEINIT""">*/"// Notification" \n
                         "[""BIS_Showcase_FFV_UAV_taken"", [name _unit]] call BIS_fnc_showNotification;" \n
                         "" \n
                         "// Remove UAV terminal" \n
                         "player unlinkItem ""B_UavTerminal"";" \n
                         "" \n
                         "if (""ItemGPS"" in items player) then {" \n
                         "	player assignItem ""ItemGPS"";" \n
                         "} else {" \n
                         "	player linkItem ""ItemGPS"";" \n
