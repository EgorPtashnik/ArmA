                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Disconnected">*/
                                class Disconnected
                                {
                                        itemno = 8;
