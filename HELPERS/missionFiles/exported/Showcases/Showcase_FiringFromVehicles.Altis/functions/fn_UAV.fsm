                                        itemno = 17;
                                        priority = 0.000000;
                                        to="Determine_user";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"isUAVConnected BIS_UAV"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Allow_connect">*/
                class Allow_connect
                {
                        name = "Allow_connect";
                        itemno = 19;
                        init = /*%FSM<STATEINIT""">*/"// Notification" \n
                         """BIS_Showcase_FFV_UAV_enabled"" call BIS_fnc_showNotification;" \n
                         "" \n
                         "// Connection hint" \n
                         "[[""UAV"", ""Connection""]] call BIS_fnc_advHint;" \n
                         "" \n
                         "// Add UAV terminal" \n
                         "player unlinkItem ""ItemGPS"";" \n
