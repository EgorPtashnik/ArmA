                {
                        name = "Unlock_view";
                        itemno = 7;
                        init = /*%FSM<STATEINIT""">*/"// Unlock the view" \n
                         "BIS_UAV lockCameraTo [objNull, [0]];" \n
                         "" \n
                         "if (currentVisionMode BIS_UAVG != 2) then {" \n
