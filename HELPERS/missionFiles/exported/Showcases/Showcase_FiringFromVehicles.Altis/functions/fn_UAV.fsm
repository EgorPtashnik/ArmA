                         "	player assignItem ""B_UavTerminal"";" \n
                         "} else {" \n
                         "	player linkItem ""B_UavTerminal"";" \n
                         "};"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
