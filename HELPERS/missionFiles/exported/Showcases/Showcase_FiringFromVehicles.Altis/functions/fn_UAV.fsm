                /*%FSM</STATE>*/
                /*%FSM<STATE "Terminate">*/
                class Terminate
                {
                        name = "Terminate";
                        itemno = 31;
                        init = /*%FSM<STATEINIT""">*/"// Remove UAV terminal" \n
                         "player unlinkItem ""B_UavTerminal"";" \n
                         "" \n
                         "if (""ItemGPS"" in items player) then {" \n
                         "	player assignItem ""ItemGPS"";" \n
                         "} else {" \n
                         "	player linkItem ""ItemGPS"";" \n
                         "};" \n
                         "" \n
                         "// Force out of UAV view" \n
                         "if (cameraOn != vehicle player) then {" \n
                         "	[] spawn {" \n
                         "		disableSerialization;" \n
                         "		" \n
                         "		scriptName ""BIS_Showcase_FFV_fnc_UAV: terminate"";" \n
                         "		" \n
                         "		if (!(BIS_outOfTime)) then {sleep 3};" \n
                         "		" \n
                         "		if (cameraOn != vehicle player) then {" \n
                         "			private [""_layer""];" \n
                         "			_layer = ""BIS_static"" call BIS_fnc_rscLayer;" \n
                         "			_layer cutRsc [""RscStatic"", ""PLAIN""];" \n
                         "			" \n
                         "			sleep 0.5;" \n
                         "			" \n
                         "			titleCut ["""", ""BLACK IN"", 1];" \n
                         "			vehicle player switchCamera ""INTERNAL"";" \n
                         "		};" \n
                         "	};" \n
                         "};"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
        };
        initState="UAV_Control";
        finalStates[] =
        {
                "Terminate",
        };
};
/*%FSM</COMPILE>*/