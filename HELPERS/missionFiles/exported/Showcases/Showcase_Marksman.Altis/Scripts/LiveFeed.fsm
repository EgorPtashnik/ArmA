       "		14756.8," \n
       "		700" \n
       "	        ];" \n
       "	" \n
       "	[_pos, (getMarkerPos ""BIS_mrkCamp""), BIS_Player,0] call BIS_fnc_liveFeed;" \n
       "" \n
       "	If (!(isNil ""BIS_liveFeed"")) Then {" \n
       "		BIS_liveFeed camPrepareFOV 0.1;" \n
       "		BIS_liveFeed camCommitPrepared 0;" \n
       "		};" \n
       "" \n
       "        sleep 0.05;" \n
