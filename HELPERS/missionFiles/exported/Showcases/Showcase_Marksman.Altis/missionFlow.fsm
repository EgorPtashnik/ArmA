class FSM
{
  fsmName = "missionFlow";
  class States
  {
    /*%FSM<STATE "Start">*/
    class Start
    {
      name = "Start";
      itemno = 0;
      init = /*%FSM<STATEINIT""">*/"// Detection for leaving AO in each phase" \n
       "Phase = 1;" \n
       "" \n
       "BIS_Task01_Done = false;" \n
       "BIS_Task01a_Done = false;" \n
       "BIS_Task02_Done = false;" \n
       "BIS_Task03_Done = false;" \n
       "" \n
       "BIS_VillaCleared = false;" \n
       "BIS_LZCleared = false;" \n
       "BIS_CampCleared = false;" \n
       "" \n
       "BIS_AttackStarted = false;" \n
       "" \n
       "BIS_LeftAO01 = false;" \n
       "BIS_LeftAO02 = false;" \n
       "" \n
       "BIS_TaruKO = false;" \n
       "" \n
       "0 fadeMusic 0;" \n
       "" \n
       "{_x setMarkerAlpha 0} forEach" \n
       "        [" \n
       "                ""BIS_mrkLZ01""," \n
       "                ""BIS_mrkLZ01_area""," \n
       "                ""BIS_mrkLZ02""," \n
       "                ""BIS_mrkCamp""," \n
       "                ""BIS_mrkCampArea""," \n
       "                ""BIS_mrkAttack""," \n
       "                ""BIS_mrkOverlook""" \n
       "        ];" \n
       "" \n
       "{_underFire = _x execFSM ""Scripts\UnderFire.fsm""} forEach" \n
       "        [" \n
       "                (group BIS_FIA_A2)," \n
       "                (group BIS_FIA_A4)," \n
       "                (group BIS_FIA_A5)," \n
       "                (group BIS_FIA_B1)," \n
       "                (group BIS_FIA_B2)," \n
       "                (group BIS_FIA_B4)" \n
       "        ];" \n
       "" \n
       "{_x stop true; _x hideObject true; _x disableAI ""move""; _x disableAI ""anim"", _x disableAI ""target"", _x disableAI ""autotarget"", _x disableAI ""FSM""} forEach" \n
       "        (" \n
       "                units BIS_grpFIA01 + " \n
       "                units BIS_grpFIA02 +" \n
       "                units BIS_grpFIA03 +" \n
       "                units BIS_grpFIA04 +" \n
       "                units BIS_grpFIA05 +" \n
       "                units BIS_grpFIA06 +" \n
       "                units BIS_grpFIA07 +" \n
       "                units BIS_grpAttackGroup" \n
       "        );" \n
       "" \n
       "// *****************" \n
       "// Blackout at the camp" \n
       "// *****************" \n
       "" \n
       "_lampClasses = " \n
       "[" \n
       "	""Land_LampAirport_F""," \n
       "	""Land_LampDecor_F""," \n
       "	""Land_LampHalogen_F""," \n
       "	""Land_LampHarbour_F""," \n
       "	""Land_LampShabby_F""," \n
       "	""Land_LampSolar_F""," \n
       "	""Land_LampStadium_F""," \n
       "	""Land_LampStreet_F""," \n
       "	""Land_LampStreet_small_F""," \n
       "	""Land_PowerPoleWooden_F""," \n
       "	""Land_PowerPoleWooden_L_F""," \n
       "	""Land_PowerPoleWooden_small_F""" \n
       "];" \n
       "" \n
       "for [{_i=0},{_i < (count _lampClasses)},{_i=_i+1}] do" \n
       "{" \n
       "	_lamps = getMarkerPos ""BIS_mrkCamp"" nearObjects [_lampClasses select _i, 100];" \n
       "	{_x setDamage 0.95} forEach _lamps;" \n
       "};" \n
       ""/*%FSM</STATEINIT""">*/;
      precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
      class Links
      {
        /*%FSM<LINK "Mission_started">*/
        class Mission_started
        {
          itemno = 6;
          priority = 0.000000;
          to="Prologue";
          precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
          condition=/*%FSM<CONDITION""">*/"!(isNil ""BIS_missionStarted"")" \n
           ""/*%FSM</CONDITION""">*/;
          action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
        };
        /*%FSM</LINK>*/
      };
    };
    /*%FSM</STATE>*/
    /*%FSM<STATE "Search_for_intel">*/
    class Search_for_intel
    {
      name = "Search_for_intel";
      itemno = 2;
      init = /*%FSM<STATEINIT""">*/"_t = time;" \n
       "" \n
       "[] spawn {" \n
       "" \n
       "sleep 5;" \n
       "[""BIS_tskVilla"", ""Succeeded""] call BIS_fnc_missionTasks;" \n
       "[""BIS_tskIntel"", ""Current""] call BIS_fnc_missionTasks;" \n
       "" \n
       """VillaCleared"" call BIS_fnc_missionConversations;" \n
       "" \n
       "sleep 5;" \n
       "saveGame;" \n
       "" \n
       "sleep 2.5;" \n
       "BIS_Task01_Done = true;" \n
       "" \n
       "};" \n
       "" \n
       "{_x removeAllEventHandlers ""Fired""} forEach BIS_VillaUnits;" \n
       ""/*%FSM</STATEINIT""">*/;
      precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
      class Links
      {
        /*%FSM<LINK "Timeout__1a">*/
        class Timeout__1a
        {
          itemno = 4;
          priority = 0.000000;
          to="END_FAIL";
          precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
          condition=/*%FSM<CONDITION""">*/"(time > _t + 600) or" \n
           "(BIS_LeftAO01)" \n
           ""/*%FSM</CONDITION""">*/;
          action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
        };
        /*%FSM</LINK>*/
        /*%FSM<LINK "Found">*/
        class Found
        {
          itemno = 3;
          priority = 0.000000;
          to="Secure_LZ";
          precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
          condition=/*%FSM<CONDITION""">*/"(BIS_Task01_Done) and" \n
           "(BIS_Player distance BIS_Intel < 2.5) and" \n
           "(getPosATL BIS_Player select 2 > 3.5)" \n
           ""/*%FSM</CONDITION""">*/;
          action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
        };
        /*%FSM</LINK>*/
      };
    };
    /*%FSM</STATE>*/
    /*%FSM<STATE "Prologue">*/
    class Prologue
    {
      name = "Prologue";
      itemno = 5;
      init = /*%FSM<STATEINIT""">*/"_t = time;" \n
       "" \n
       "[] spawn {" \n
       "" \n
       "sleep 2;" \n
       """Prologue"" call BIS_fnc_missionConversations;" \n
       "" \n
       "playMusic ""AmbientTrack01_F"";" \n
       "5 fadeMusic 0.35;" \n
       "" \n
       "sleep 5;" \n
       "_null = [[""Weapons_basic"", ""WeaponResting""], 15] spawn BIS_fnc_advHint;" \n
       "" \n
       "sleep 30;" \n
       "_null = [[""Weapons_basic"", ""WeaponDeployment""], 15] spawn BIS_fnc_advHint;" \n
       "" \n
       "};" \n
       "" \n
       "// Event handler Fired to trigger alarm at first two FIA bases" \n
       "" \n
       "{_x addEventHandler" \n
       "[""Fired"",{_null = _this spawn {{_x removeAllEventHandlers ""Fired""; sleep (random 5); _x setBehaviour ""Combat""} forEach BIS_VillaUnits}}]" \n
       "} forEach BIS_VillaUnits;" \n
       "" \n
       "{_x addEventHandler " \n
       "[""Fired"",{_null = _this spawn {{_x removeAllEventHandlers ""Fired""; sleep (random 5); _x setBehaviour ""Combat""} forEach BIS_LZUnits}}]" \n
       "} forEach BIS_LZUnits;" \n
       ""/*%FSM</STATEINIT""">*/;
      precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
      class Links
      {
        /*%FSM<LINK "Timeout__1">*/
        class Timeout__1
        {
          itemno = 24;
          priority = 0.000000;
          to="END_FAIL";
          precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
          condition=/*%FSM<CONDITION""">*/"(time > _t + 1200) or" \n
           "(BIS_LeftAO01)" \n
           ""/*%FSM</CONDITION""">*/;
          action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
        };
        /*%FSM</LINK>*/
        /*%FSM<LINK "FIA_eliminated">*/
        class FIA_eliminated
        {
          itemno = 1;
          priority = 0.000000;
          to="Search_for_intel";
          precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
          condition=/*%FSM<CONDITION""">*/"(({alive _x} count BIS_VillaUnits == 0)         " \n
           "or         " \n
           "((BIS_VillaCleared) and" \n
           "({alive _x} count BIS_VillaUnits < 2))) " \n
           "and" \n
           "(BIS_Player distance getMarkerPos ""BIS_mrkVilla"" < 25)" \n
           ""/*%FSM</CONDITION""">*/;
          action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
        };
        /*%FSM</LINK>*/
      };
    };
    /*%FSM</STATE>*/
    /*%FSM<STATE "Secure_LZ">*/
    class Secure_LZ
    {
      name = "Secure_LZ";
      itemno = 7;
      init = /*%FSM<STATEINIT""">*/"_t = time;" \n
       "" \n
       "BIS_Task01a_Done = true;" \n
       "" \n
       "BIS_FIA_B2 setPos getMarkerPos ""BIS_mrkPos01"";" \n
       "BIS_FIA_B3 setPos getMarkerPos ""BIS_mrkPos02"";" \n
       "(group BIS_FIA_B2) copyWaypoints (BIS_grpNewWP);" \n
       "" \n
       "If ({alive _x} count [BIS_FIA_B1,BIS_FIA_B4,BIS_FIA_B5] < 3) Then {" \n
       "(group BIS_FIA_B2) setBehaviour ""Combat"";" \n
       "};" \n
       "" \n
       "[] spawn {" \n
       "" \n
       "sleep 2;" \n
       "[""BIS_tskIntel"", ""Succeeded""] call BIS_fnc_missionTasks;" \n
       "" \n
       """IntelFound"" call BIS_fnc_missionConversations;" \n
       "[""BIS_tskLZ"", ""Current""] call BIS_fnc_missionTasks;" \n
       """BIS_mrkLZ01"" setMarkerAlpha 1;" \n
       """BIS_mrkLZ01_area"" setMarkerAlpha 1;" \n
       "" \n
       "2.5 fadeMusic 0;" \n
       "" \n
       "sleep 3;" \n
       "2.5 fadeMusic 0.5;" \n
       "playMusic ""AmbientTrack01_F_EPB"";" \n
       "" \n
       "};" \n
       "" \n
       "/*" \n
       "To avoid problems with fullfiling first three tasks in different order" \n
       "there will be FIA at the LZ from the start, player can go there and kill" \n
       "them right away with no comment or task done, but after he fulfills the" \n
       "first and second task, there will be new FIA at the LZ - player has to" \n
       "go there anyway and clear it (for the second time, if he was there already." \n
       "Texts, flow and everything else will stay unchanged." \n
       "" \n
       "If the previous FIA were killed at that point, the new ones will be in combat " \n
       "searching around. If not, they will be simply patrolling the area." \n
       "*/" \n
       ""/*%FSM</STATEINIT""">*/;
      precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
      class Links
      {
        /*%FSM<LINK "Timeout__2">*/
        class Timeout__2
        {
          itemno = 25;
          priority = 0.000000;
          to="END_FAIL";
          precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
          condition=/*%FSM<CONDITION""">*/"(time > _t + 1200) or" \n
           "(BIS_LeftAO01)" \n
           ""/*%FSM</CONDITION""">*/;
          action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
        };
        /*%FSM</LINK>*/
        /*%FSM<LINK "LZ_secured">*/
        class LZ_secured
        {
          itemno = 8;
          priority = 0.000000;
          to="Send_heli";
          precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
          condition=/*%FSM<CONDITION""">*/"(({alive _x} count BIS_LZUnits == 0)       " \n
           "or" \n
           "((BIS_LZCleared) and " \n
           "({alive _x} count BIS_LZUnits < 2)))        " \n
           "and        " \n
           "(BIS_Player distance getMarkerPos ""BIS_mrkLZ01"" < 50)" \n
           ""/*%FSM</CONDITION""">*/;
          action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
        };
        /*%FSM</LINK>*/
      };
    };
    /*%FSM</STATE>*/
    /*%FSM<STATE "Send_heli">*/
    class Send_heli
    {
      name = "Send_heli";
      itemno = 9;
      init = /*%FSM<STATEINIT""">*/"BIS_Task02_Done = true;" \n
       "" \n
       "[] spawn  {" \n
       "" \n
       "sleep 5;" \n
       "[""BIS_tskLZ"", ""Succeeded""] call BIS_fnc_missionTasks;" \n
       "" \n
       """LZClear"" call BIS_fnc_missionConversations;" \n
       "" \n
       "[BIS_Taru, Flight01] spawn BIS_fnc_unitPlay;" \n
       "" \n
       "[""BIS_tskGetIn"", ""Current""] call BIS_fnc_missionTasks;" \n
       "" \n
       "2.5 fadeMusic 0;" \n
       "" \n
       "sleep 3;" \n
       "2.5 fadeMusic 0.25;" \n
       "playMusic ""EventTrack03_F_EPB"";" \n
       "" \n
       "};" \n
       "" \n
       "{_x removeAllEventHandlers ""Fired""} forEach BIS_LZUnits;" \n
       ""/*%FSM</STATEINIT""">*/;
      precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
      class Links
      {
        /*%FSM<LINK "Taru_KO">*/
        class Taru_KO
        {
          itemno = 32;
          priority = 0.000000;
          to="END_FAIL";
          precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
          condition=/*%FSM<CONDITION""">*/"BIS_TaruKO"/*%FSM</CONDITION""">*/;
          action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
        };
        /*%FSM</LINK>*/
        /*%FSM<LINK "Heli_close">*/
        class Heli_close
        {
          itemno = 21;
          priority = 0.000000;
          to="Get_in";
          precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
          condition=/*%FSM<CONDITION""">*/"BIS_Taru distance BIS_LZ01 < 250" \n
           ""/*%FSM</CONDITION""">*/;
          action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
        };
        /*%FSM</LINK>*/
      };
    };
    /*%FSM</STATE>*/
    /*%FSM<STATE "Flight">*/
    class Flight
    {
      name = "Flight";
      itemno = 11;
      init = /*%FSM<STATEINIT""">*/"BIS_Taru addWeaponCargo [""srifle_DMR_05_blk_F"",1];" \n
       "BIS_Taru addWeaponCargo [""srifle_DMR_04_F"",1];" \n
       "BIS_Taru addMagazineCargo [""10Rnd_93x64_DMR_05_Mag"",6];" \n
       "BIS_Taru addMagazineCargo [""10Rnd_127x54_Mag"",6];" \n
       "BIS_Taru addMagazineCargo [""SmokeShell"",2];" \n
       "BIS_Taru addMagazineCargo [""HandGrenade"",2];" \n
       "BIS_Taru addItemCargo [""optic_KHS_blk"",1];" \n
       "BIS_Taru addItemCargo [""bipod_02_F_blk"",1];" \n
       "BIS_Taru addItemCargo [""FirstAidKit"",2];" \n
       "BIS_Taru addItemCargo [""U_O_FullGhillie_lsh"",1];" \n
       "" \n
       "[] spawn {" \n
       "" \n
       "BIS_Taru lock true;" \n
       "" \n
       "[""BIS_tskGetIn"", ""Succeeded""] call BIS_fnc_missionTasks;" \n
       "[""BIS_tskGetIn"", objNull] call BIS_fnc_taskSetDestination;" \n
       "" \n
       "0 fadeMusic 0.35;" \n
       "playMusic ""LeadTrack01_F_Heli"";" \n
       "" \n
       "sleep 35;" \n
       "2.5 fadeSound 0.5;" \n
       """ChangeOfPlan"" call BIS_fnc_missionConversations;" \n
       "2.5 fadeSound 1;" \n
       "" \n
       "sleep 24;" \n
       "2.5 fadeSound 0.5;" \n
       """Details"" call BIS_fnc_missionConversations;" \n
       "2.5 fadeSound 1;" \n
       "" \n
       """BIS_tskCamp"" call BIS_fnc_missionTasks;" \n
       "" \n
       "{_x setMarkerAlpha 1} forEach" \n
