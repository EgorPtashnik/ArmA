                                        priority = 0.000000;
                                        to="Comms";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!_stepAlpha &&" \n
                                         "((units _alphaGrp) findIf { alive _x }) == -1"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Bravo_Combat">*/
                                class Bravo_Combat
                                {
                                        itemno = 16;
                                        priority = 0.000000;
                                        to="OPFOR_Response_1";
