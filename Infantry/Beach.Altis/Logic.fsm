class FSM
{
        fsmName = "missionFlow";
        class States
        {
                /*%FSM<STATE "start">*/
                class start
                {
                        name = "start";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"private [""_time"", ""_handle""];"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "CHEAT_Assault">*/
                                class CHEAT_Assault
                                {
                                        itemno = 29;
                                        priority = 2.000000;
                                        to="Prepare_Assault";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"false"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Mission_started">*/
                                class Mission_started
                                {
                                        itemno = 1;
                                        priority = 0.000000;
                                        to="Insertion";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > 0"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Insertion">*/
                class Insertion
                {
                        name = "Insertion";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"[""EP_blackScreen"", false] call BIS_fnc_blackOut;" \n
                         "[0, 0, false, true] call BIS_fnc_cinemaBorder;" \n
                         "spawn {" \n
                         "	sleep 3;" \n
                         "" \n
                         "	[""EP_blackScreen"", false] spawn BIS_fnc_blackIn;" \n
                         "	private _handle = [1, ""BLACK"", 5, 0] spawn BIS_fnc_fadeEffect;" \n
                         "	playMusic ""Track_R_09"";" \n
                         "" \n
                         "	waitUntil { scriptDone _handle };" \n
                         "	[1, 1.5, false, true] call BIS_fnc_cinemaBorder;" \n
                         "	sleep 1.5;" \n
                         "" \n
                         "	_handle = [[ " \n
                         "		[""CAMP VANGUARD"", ""<t align='start' shadow='1' size='0.7' font='PuristaBold'>%1</t><br/>"", 10], " \n
                         "		[""GRID "" + mapGridPosition player, ""<t align='start' shadow='1' size='0.7' font='PuristaMedium'>%1</t><br/>"", 10], " \n
                         "		[(""2025, JUNE, "") + ([dayTime, ""HH:MM""] call BIS_fnc_timeToString), ""<t align='start' shadow='1' size='0.7' font='PuristaMedium'>%1</t>"", 30] " \n
                         "	], 0, 0] spawn BIS_fnc_typeText;" \n
                         "	waitUntil { scriptDone _handle };" \n
                         "	""C1"" call EP_fnc_missionConversations;" \n
                         "};" \n
                         "" \n
                         "[B_Apc, ""B_WpInsertion"", ""TR UNLOAD""] call EP_fnc_addWaypoint;" \n
                         "" \n
                         "//TODO Comms" \n
                         "" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Insertion_Done">*/
                                class Insertion_Done
                                {
                                        itemno = 3;
                                        priority = 0.000000;
                                        to="Send_Blufor_Infa";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"((units B_Inf) findIf {_x in B_Apc}) == -1"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Send_Blufor_Infa">*/
                class Send_Blufor_Infa
                {
                        name = "Send_Blufor_Infa";
                        itemno = 4;
                        init = /*%FSM<STATEINIT""">*/"// Send player group to outpost" \n
                         "[B_Inf, ""O_MrkOutpost""] call EP_fnc_addWaypoint;" \n
                         "" \n
                         "// TODO Comms"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Combat_Started">*/
                                class Combat_Started
                                {
                                        itemno = 5;
                                        priority = 0.000000;
                                        to="OPFOR_Response";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(combatBehaviour O_InfOutpost) == ""COMBAT"""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "OPFOR_Response">*/
                class OPFOR_Response
                {
                        name = "OPFOR_Response";
                        itemno = 6;
                        init = /*%FSM<STATEINIT""">*/"[O_InfOutpost, ""O_MrkOutpost"", ""GUARD"", ""RED"", ""COMBAT""] call EP_fnc_addWaypoint;" \n
                         "" \n
                         "// Trigger for outpost capture" \n
                         "private _trigger = [""O_MrkOutpost"", 1, [100, 100, 0, false], [""EAST"", ""NOT PRESENT"", false], [{this}, {}, {}] ] call EP_fnc_createTrigger;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Outpost_Captured">*/
                                class Outpost_Captured
                                {
                                        itemno = 7;
                                        priority = 0.000000;
                                        to="Spawn_OPFOR_QRF";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"triggerActivated _trigger"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Spawn_OPFOR_QRF">*/
                class Spawn_OPFOR_QRF
                {
                        name = "Spawn_OPFOR_QRF";
                        itemno = 8;
                        init = /*%FSM<STATEINIT""">*/"deleteVehicle _trigger;" \n
                         """O_MrkOutpost"" setMarkerColor ""ColorWEST"";" \n
                         "private _time = time;" \n
                         "" \n
                         "" \n
                         "[B_Apc, ([""O_MrkOutpost"", 100] call EP_fnc_getRandomPosition)] call EP_fnc_addWaypoint;" \n
                         "[B_Inf, ""O_MrkOutpost"", ""GUARD"", ""COMBAT""] call EP_fnc_addWaypoint;" \n
                         "" \n
                         "// TODO Comms" \n
                         "" \n
                         "// Spawn OPFOR QRF" \n
                         "private _qrf = call compileScript [""scripts\SpawnQRF.sqf"", true];" \n
                         "//TODO Comms" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Timeout">*/
                                class Timeout
                                {
                                        itemno = 10;
                                        priority = 0.000000;
                                        to="Send_Heli_Reinf";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > _time + 600"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "QRF_KIA">*/
                                class QRF_KIA
                                {
                                        itemno = 9;
                                        priority = 0.000000;
                                        to="Send_Heli_Reinf";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"((units _qrf) findIf {alive _x}) == -1"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Send_Heli_Reinf">*/
                class Send_Heli_Reinf
                {
                        name = "Send_Heli_Reinf";
                        itemno = 11;
                        init = /*%FSM<STATEINIT""">*/"// Show and send helicopters" \n
                         "[""B_Helis"", true] call EP_fnc_showObjects;" \n
                         "[B_Heli_1, Helipad_1, ""CARELESS"", [ { true }, { B_Heli_1 landAt [Helipad_1, ""GetOut""] } ]] call EP_fnc_addWaypoint;" \n
                         "[B_Heli_1, Helipad_1, ""TR UNLOAD""] call EP_fnc_addWaypoint;" \n
                         "[B_Heli_1, B_Heli_1, [{ true }, { [this, 50] call EP_fnc_cleanupArea }]] call EP_fnc_addWaypoint;" \n
                         "" \n
                         "[B_Heli_2, Helipad_2, ""CARELESS"", [ { true }, { B_Heli_2 landAt [Helipad_2, ""GetOut""] } ]] call EP_fnc_addWaypoint;" \n
                         "[B_Heli_2, Helipad_2, ""TR UNLOAD""] call EP_fnc_addWaypoint;" \n
                         "[B_Heli_2, B_Heli_2, [{ true }, { [this, 50] call EP_fnc_cleanupArea }]] call EP_fnc_addWaypoint;" \n
                         "" \n
                         "[B_Heli_3, Helipad_3, ""CARELESS"", [ { true }, { B_Heli_3 landAt [Helipad_3, ""GetOut""] } ]] call EP_fnc_addWaypoint;" \n
                         "[B_Heli_3, Helipad_3, ""TR UNLOAD""] call EP_fnc_addWaypoint;" \n
                         "[B_Heli_3, B_Heli_3, [{ true }, { [this, 50] call EP_fnc_cleanupArea }]] call EP_fnc_addWaypoint;" \n
                         "" \n
                         "" \n
                         "private _heliInfUnits = [B_InfHeli_1, B_InfHeli_2, B_InfHeli_3] call EP_fnc_collectUnits;" \n
                         "" \n
                         "// TODO Comms"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Heli_Reinf_Arriv">*/
                                class Heli_Reinf_Arriv
                                {
                                        itemno = 12;
                                        priority = 0.000000;
                                        to="Assault_Phase";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(_heliInfUnits findIf { vehicle _x != _x }) == -1"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Assault_Phase">*/
                class Assault_Phase
                {
                        name = "Assault_Phase";
                        itemno = 13;
                        init = /*%FSM<STATEINIT""">*/"""O_MrkAlpha"" setMarkerAlpha 1;" \n
                         """O_MrkBravo"" setMarkerAlpha 1;" \n
                         "" \n
                         "// TODO Comms" \n
                         "" \n
                         "// Send one group to point Alpha" \n
                         "[B_InfHeli_3, ""O_MrkAlpha""] call EP_fnc_addWaypoint;" \n
                         "" \n
                         "// Send others to Bravo" \n
                         "{ [B_InfHeli_1, _x] call EP_fnc_addWaypoint } forEach [""O_Wp_InfHeli_1_1"", ""O_MrkBravo""];" \n
                         "{ [B_InfHeli_2, _x] call EP_fnc_addWaypoint } forEach [""O_Wp_InfHeli_2_1"", ""O_Wp_InfHeli_2_2"", ""O_MrkBravo""];" \n
                         "" \n
                         "B_Inf call EP_fnc_clearWaypoints;" \n
                         "[B_Inf, ""O_MrkBravo""] call EP_fnc_addWaypoint;" \n
                         "" \n
                         "" \n
                         "//********************************************************************" \n
                         "// OPFOR Setup" \n
                         "//********************************************************************" \n
                         "" \n
                         "// Alpha" \n
                         "private _alphaClasses = [" \n
                         "    ""Atlas_O_Soldier_R_TL_F"", " \n
                         "    ""Atlas_O_Soldier_R_GL_F"", " \n
                         "    ""Atlas_O_Soldier_R_M_F"", " \n
                         "    ""Atlas_O_Soldier_R_AR_F""" \n
                         "];" \n
                         "" \n
                         "private _alphaGrp = [""O_MrkAlpha"", opfor, _alphaClasses] call EP_fnc_createGroup;" \n
                         "hint str _alphaGrp;" \n
                         "[_alphaGrp, _alphaGrp, ""GUARD""] call EP_fnc_addWaypoint;" \n
                         "" \n
                         "" \n
                         "//Bravo" \n
                         "[""O_Bravo"", true] call EP_fnc_showObjects;" \n
                         "[O_BravoGuards, O_BravoGuards, 200] call EP_fnc_taskDefend;" \n
                         "[(units O_BravoStatic), ""UP"", [""PATH"", false]] call EP_fnc_setAIMode;" \n
                         "" \n
                         "private _bravoGroups = [O_BravoGuards, O_BravoPatrol, O_BravoStatic];" \n
                         "private _bravoUnits = _bravoGroups call EP_fnc_collectUnits;" \n
                         "private _bravoThreshold = (count _bravoUnits) * 0.1;" \n
                         "private _bluforThreshold = 10;" \n
                         "" \n
                         "private _stepAlpha = false;" \n
                         "private _stepBravoCombat = false;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "BLUFOR_Casualtie">*/
                                class BLUFOR_Casualtie
                                {
                                        itemno = 27;
                                        priority = 0.000000;
                                        to="BLUFOR_Retreat";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"({ alive _x } count _heliInfUnits) < _bluforThreshold"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Alpha_Captured">*/
                                class Alpha_Captured
                                {
                                        itemno = 14;
                                        priority = 0.000000;
                                        to="Comms";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!_stepAlpha &&" \n
                                         "((units _alphaGrp) findIf { alive _x }) == -1"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Bravo_Combat">*/
                                class Bravo_Combat
                                {
                                        itemno = 16;
                                        priority = 0.000000;
                                        to="OPFOR_Response_1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!_stepBravoCombat &&" \n
                                         "(_bravoGroups findIf { (combatBehaviour _x) == ""COMBAT"" }) != -1"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Bravo_Captured">*/
                                class Bravo_Captured
                                {
                                        itemno = 18;
                                        priority = 0.000000;
                                        to="OPFOR_Surrender";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"({ alive _x } count _bravoUnits) < _bravoThreshold"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
