                class Comms
                {
                        name = "Comms";
                        itemno = 15;
                        init = /*%FSM<STATEINIT""">*/"_stepAlpha = true;" \n
                         "" \n
                         """O_MrkAlpha"" setMarkerColor ""ColorWEST"";" \n
