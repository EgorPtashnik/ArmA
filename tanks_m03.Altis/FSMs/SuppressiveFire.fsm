class FSM
{
        fsmName = "SuppressiveFire";
        class States
        {
                /*%FSM<STATE "Start">*/
                class Start
                {
                        name = "Start";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"// Makes one vehicle suppress one of the provided positions" \n
                         "// Params" \n
                         "params" \n
                         "[" \n
                         "	[""_vehicle"",objNull,[objNull]]," \n
                         "	[""_targets"",[],[[]]]," \n
                         "	[""_delay"",[15,20],[[]]]," \n
                         "	[""_suppressTime"",[4,6],[[]]]" \n
                         "];" \n
                         "" \n
                         "// Add time limit, as NATO troops are moving into the area that is under suppressive fire" \n
                         "_t = time;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "_">*/
                                class _
                                {
                                        itemno = 1;
                                        priority = 0.000000;
                                        to="Feuer_frei_";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Feuer_frei_">*/
                class Feuer_frei_
                {
                        name = "Feuer_frei_";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"_t = time;" \n
                         "" \n
                         "_vehicle doSuppressiveFire (selectRandom _targets);" \n
                         "// _vehicle suppressFor ((_suppressTime select 0) + (random ((_suppressTime select 1) - (_suppressTime select 0))));" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Interrupted">*/
                                class Interrupted
                                {
                                        itemno = 3;
                                        priority = 5.000000;
                                        to="END";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(damage _vehicle > 0) or" \n
                                         "((commander _vehicle) knowsAbout (vehicle BIS_ARPlayer) > 1.5) /*or" \n
                                         "(time > _t + 75)*/" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Timeout">*/
                                class Timeout
                                {
                                        itemno = 6;
                                        priority = 0.000000;
                                        to="Replenish_ammo";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > (_t + (_delay select 0) + (random ((_delay select 1) - (_delay select 0))))" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "END">*/
                class END
                {
                        name = "END";
                        itemno = 4;
                        init = /*%FSM<STATEINIT""">*/""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Replenish_ammo">*/
                class Replenish_ammo
                {
                        name = "Replenish_ammo";
                        itemno = 5;
                        init = /*%FSM<STATEINIT""">*/"_vehicle setVehicleAmmo 1;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "_">*/
                                class _
                                {
                                        itemno = 1;
                                        priority = 0.000000;
                                        to="Feuer_frei_";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
        };
        initState="Start";
        finalStates[] =
        {
                "END",
        };
