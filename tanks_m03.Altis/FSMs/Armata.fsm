                {
                        name = "Report__destroy";
                        itemno = 4;
                        init = /*%FSM<STATEINIT""">*/"[] spawn {" \n
                         "	sleep 3;" \n
                         "	""Armata02_inside"" call BIS_fnc_missionConversations;" \n
                         "	[""BIS_tskInvestigateTank"",""Succeeded""] call BIS_fnc_missionTasks;" \n
                         "	sleep 3;" \n
                         "	""Armata02_report"" call BIS_fnc_missionConversations;" \n
                         "	[""BIS_tskDestroyTank"",""Current""] call BIS_fnc_missionTasks;" \n
                         "};" \n
                         "" \n
                         "BIS_Tank addEventHandler [""Killed"",{(_this select 1) addRating 7500}];" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
