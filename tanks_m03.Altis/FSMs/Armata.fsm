                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"// Disable damage so it will survive the air strike" \n
                         "BIS_Tank allowDamage false;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
