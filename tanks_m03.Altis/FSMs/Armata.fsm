                        name = "Comment__get_ins";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"if (alive BIS_ARDriver) then {" \n
                         "	""Armata02_nearby"" spawn BIS_fnc_missionConversations;" \n
                         "} else {" \n
                         "	""Armata02_nearbyAlone"" spawn BIS_fnc_missionConversations;" \n
                         "};" \n
