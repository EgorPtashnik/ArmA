                         "	sleep 1;" \n
                         "	[""BIS_tskDestroyTank"",""Succeeded""] call BIS_fnc_missionTasks;" \n
                         "	sleep 2;" \n
                         "	""Armata02_destroyed"" call BIS_fnc_missionConversations;" \n
                         "	if !(""BIS_tskDefense"" call BIS_fnc_taskState == ""Succeeded"") then {[""BIS_tskDefense"",""Current""] call BIS_fnc_missionTasks};" \n
